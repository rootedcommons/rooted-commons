---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LiveNetworkHydrator from '../components/LiveNetworkHydrator.astro';
import ClientData from '../components/ClientData.astro';
import '../styles/global.css';
const { settings, pages, title, description, noIndex = false } = Astro.props;
const pageTitle = title ? `${title} | ${settings.siteTitle}` : settings.siteTitle;
const noIndexPaths = new Set(['/404/','/account/','/checkout/','/contact/','/dashboard/','/membership-terms/','/order/','/partner-map/','/privacy/','/signin/','/signup/','/terms-of-sale/']);
const shouldNoIndex = noIndex || noIndexPaths.has(Astro.url.pathname);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description || settings.tagline} />
    {shouldNoIndex && <meta name="robots" content="noindex, follow" />}
    <title>{pageTitle}</title>
    <ClientData />
    <slot name="head" />
    <style define:vars={{
      primary: settings.primaryColour,
      background: settings.backgroundColour,
      surface: settings.surfaceColour || '#faf7f2',
      highlight: settings.highlightColour,
      line: settings.borderColour,
      accent: settings.accentColour || '#3f6b3d'
    }}></style>
  </head>
  <body>
    <Header settings={settings} pages={pages} />
    <main><slot /></main>
    <Footer settings={settings} />
    <LiveNetworkHydrator />
  </body>
</html>
