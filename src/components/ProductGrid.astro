---
const { products, category = '', columns = 3, showControls = false, settings = {}, content = {} } = Astro.props;
const wanted = String(category || '').trim().toLowerCase();
const money = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' });
const filtered = wanted
  ? products.filter((product) => (product.categories || [product.category]).some((item) => String(item).trim().toLowerCase() === wanted))
  : products;

const certificationLogos = {
  'soil association': settings.soilAssociationLogo,
  'eu organic': settings.euOrganicLogo,
  'wildfarmed': settings.wildfarmedLogo,
  'organic food federation': settings.organicFoodFederationLogo
};
const cleanValues = (values = []) => values.map((value) => String(value || '').trim()).filter(Boolean);
const hasValue = (value) => value !== null && value !== undefined && String(value).trim() !== '';
const nutritionNumber = (value) => {
  if (!hasValue(value)) return '';
  const raw = String(value).trim();
  const numericValue = Number(raw);
  return Number.isFinite(numericValue) ? String(numericValue) : raw;
};
const nutritionRowsFor = (product) => [
  ['Energy', [
    hasValue(product.energyKj) ? `${nutritionNumber(product.energyKj)} kJ` : '',
    hasValue(product.energyKcal) ? `${nutritionNumber(product.energyKcal)} kcal` : ''
  ].filter(Boolean).join(' / ')],
  ['Fat', hasValue(product.fat) ? `${nutritionNumber(product.fat)} g` : ''],
  ['of which saturates', hasValue(product.saturates) ? `${nutritionNumber(product.saturates)} g` : ''],
  ['Carbohydrate', hasValue(product.carbohydrate) ? `${nutritionNumber(product.carbohydrate)} g` : ''],
  ['of which sugars', hasValue(product.sugars) ? `${nutritionNumber(product.sugars)} g` : ''],
  ['Fibre', hasValue(product.fibre) ? `${nutritionNumber(product.fibre)} g` : ''],
  ['Protein', hasValue(product.protein) ? `${nutritionNumber(product.protein)} g` : ''],
  ['Salt', hasValue(product.salt) ? `${nutritionNumber(product.salt)} g` : '']
].filter(([, value]) => value);

const displayProducts = filtered.map((product) => {
  const categories = cleanValues(product.categories || [product.category]);
  const subcategories = cleanValues(product.subcategories || [product.subcategory]);
  const countries = cleanValues(product.grownIn || []);
  const certifications = cleanValues(product.certifications || []);
  const availableStock = Math.max(0, Number(product.availableStock ?? 0));
  const lowStockThreshold = Math.max(0, Number(product.lowStockThreshold ?? 5));
  const outOfStock = product.available === false || availableStock < 1;
  const lowStock = !outOfStock && availableStock <= lowStockThreshold;
  const nutritionRows = nutritionRowsFor(product);
  const sourceValue = Number(product.sourceValue || 0);
  const commonsBalance = Number(product.priceNumber || 0) - sourceValue;
  const hasPriceBreakdown = Boolean(product.sourceValueRecipientName && sourceValue > 0);
  const hasDetails = Boolean(product.expandedDescription || product.description || product.ingredients || product.allergens || product.mayContain || product.storage || product.onceOpened || product.howToCook || product.packaging || product.disposal || product.fboImporter || product.origin || product.secondaryOrigin || nutritionRows.length);
  return { ...product, categories, subcategories, countries, certifications, availableStock, outOfStock, lowStock, nutritionRows, sourceValue, commonsBalance, hasPriceBreakdown, hasDetails };
});

const interactionPayload = {
  priceHelp: {
    source: content['price_breakdown.source_help'] || 'This is the average price Rooted Commons has paid the producer or wholesaler for the stock currently on our shelves. By pooling members’ purchasing power, we can place larger orders and access better wholesale prices while preserving producer value.',
    contribution: content['price_breakdown.contribution_help'] || 'The difference between what Rooted Commons paid for this product and the member price contributes to the storage, packing, administration and distribution behind Rooted Commons.',
    subsidy: content['price_breakdown.subsidy_help'] || 'This product costs Rooted Commons more than its member price. The difference is funded by contributions generated elsewhere in the commons, helping us keep selected products affordable.',
    member: content['price_breakdown.member_price_help'] || 'For cupboard staples, member prices are benchmarked against comparable supermarket own-brand organic products. Pooling purchasing power lets Rooted Commons offer organic staples at supermarket prices, or less, while supporting the shared infrastructure behind the commons.',
    partnerLinkLabel: content['price_breakdown.partner_link_label'] || '',
    commonsLinkLabel: content['price_breakdown.commons_link_label'] || 'Learn more in FAQs →',
    commonsLinkUrl: content['price_breakdown.commons_link_url'] || '/faqs/'
  },
  products: displayProducts.map((product) => ({
    id: product.id,
    name: product.name,
    size: product.size,
    image: product.image,
    origin: product.origin,
    secondaryOrigin: product.secondaryOrigin,
    expandedDescription: product.expandedDescription,
    description: product.description,
    ingredients: product.ingredients,
    allergens: product.allergens,
    mayContain: product.mayContain,
    storage: product.storage,
    onceOpened: product.onceOpened,
    howToCook: product.howToCook,
    packaging: product.packaging,
    disposal: product.disposal,
    fboImporter: product.fboImporter,
    nutritionBasis: product.nutritionBasis,
    nutritionRows: product.nutritionRows,
    hasDetails: product.hasDetails,
    hasPriceBreakdown: product.hasPriceBreakdown,
    sourceValue: product.sourceValue,
    sourceValueRecipientId: product.sourceValueRecipientId,
    sourceValueRecipientName: product.sourceValueRecipientName,
    commonsBalance: product.commonsBalance,
    priceNumber: product.priceNumber
  }))
};
const interactionJson = JSON.stringify(interactionPayload).replace(/</g, '\\u003c');
---
<div class="product-grid" style={`--columns:${columns}`}>
  {displayProducts.map((product) => (
    <article
      class:list={["product-card", {"product-card-out-of-stock":product.outOfStock,"product-card-low-stock":product.lowStock}]}
      data-product-card
      data-categories={product.categories.join('|')}
      data-primary-category={product.category || product.categories[0] || ''}
      data-subcategories={product.subcategories.join('|')}
      data-name={String(product.name || '').toLowerCase()}
      data-search={[product.name, product.description, product.expandedDescription, ...product.categories, ...product.subcategories, ...product.countries].filter(Boolean).join(' ').toLowerCase()}
      data-id={product.id}
      data-price={product.priceNumber}
      data-popularity={product.popularity ?? product.order ?? 9999}
      data-country={product.countries[0] || ''}
      data-stock={product.availableStock}
      data-out-of-stock={product.outOfStock ? 'true' : 'false'}
    >
      {product.hasDetails
        ? <button class="product-image-button" type="button" data-open-product aria-label={`More information about ${product.name}`}><img src={product.cardImage || product.image || '/images/placeholder.svg'} alt="" loading="lazy" /></button>
        : <img src={product.cardImage || product.image || '/images/placeholder.svg'} alt="" loading="lazy" />}
      <div class="product-copy">
        <div class="product-title-row">
          <h3>{product.hasDetails ? <button type="button" class="product-title-button" data-open-product>{product.name}</button> : product.name}</h3>
        </div>
        {product.size && <p class="product-size">{product.size}</p>}
        {(product.origin || product.secondaryOrigin) && <p class="product-origin">{[product.origin, product.secondaryOrigin].filter(Boolean).join(', ')}.</p>}
        <p class="stock-warning stock-warning-out" data-stock-out hidden={!product.outOfStock}>Out of stock</p>
        <p class="stock-warning" data-stock-low hidden={!product.lowStock}>Low stock — <span data-stock-count>{product.availableStock}</span> left</p>

        {product.certifications.length > 0 && <div class="product-certifications" aria-label="Certifications">
          {product.certifications.map((certification) => {
            const logo = certificationLogos[String(certification).toLowerCase()];
            return logo
              ? <img class="certification-logo" src={logo} alt={certification} title={certification} loading="lazy" />
              : <span class="certification-text" title={certification}>{certification}</span>;
          })}
        </div>}

        <div class="product-transaction-row">
          <div class="product-price-with-info">
            <strong class="product-price">{money.format(product.priceNumber || 0)}</strong>
            {product.hasPriceBreakdown && <button class="price-card-info-toggle" type="button" data-price-breakdown-toggle aria-expanded="false" aria-label="See where your money goes" title="Where your money goes">ⓘ</button>}
          </div>
          {showControls && <div class="quantity-control quantity-control-solid" data-quantity-control hidden={product.outOfStock} aria-label={`Quantity of ${product.name}`}>
            <button type="button" data-quantity-change="-1" aria-label="Remove one" disabled>−</button>
            <output data-quantity>0</output>
            <button type="button" data-quantity-change="1" aria-label="Add one" disabled>+</button>
          </div>}
        </div>
      </div>
    </article>
  ))}
</div>
{displayProducts.length === 0 && <p>No products currently match this section.</p>}
<script type="application/json" data-product-grid-data set:html={interactionJson}></script>
<script type="module" src="/scripts/product-interactions.js?v=2.9.76"></script>
