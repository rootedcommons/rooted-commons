---
import FormattedText from './FormattedText.astro';
const { products, category = '', columns = 3, showControls = false, settings = {}, content = {} } = Astro.props;
const wanted = String(category || '').trim().toLowerCase();
const money = new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' });
const filtered = wanted
  ? products.filter((product) => (product.categories || [product.category]).some((item) => String(item).trim().toLowerCase() === wanted))
  : products;

const certificationLogos = {
  'soil association': settings.soilAssociationLogo,
  'eu organic': settings.euOrganicLogo,
  'wildfarmed': settings.wildfarmedLogo,
  'organic food federation': settings.organicFoodFederationLogo
};
const cleanValues = (values = []) => values.map((value) => String(value || '').trim()).filter(Boolean);
const hasValue = (value) => value !== null && value !== undefined && String(value).trim() !== '';
const pounds = (value) => money.format(Math.abs(Number(value || 0)));
const nutritionRowsFor = (product) => [
  ['Energy', [
    hasValue(product.energyKj) ? `${product.energyKj} kJ` : '',
    hasValue(product.energyKcal) ? `${product.energyKcal} kcal` : ''
  ].filter(Boolean).join(' / ')],
  ['Fat', hasValue(product.fat) ? `${product.fat} g` : ''],
  ['of which saturates', hasValue(product.saturates) ? `${product.saturates} g` : ''],
  ['Carbohydrate', hasValue(product.carbohydrate) ? `${product.carbohydrate} g` : ''],
  ['of which sugars', hasValue(product.sugars) ? `${product.sugars} g` : ''],
  ['Fibre', hasValue(product.fibre) ? `${product.fibre} g` : ''],
  ['Protein', hasValue(product.protein) ? `${product.protein} g` : ''],
  ['Salt', hasValue(product.salt) ? `${product.salt} g` : '']
].filter(([, value]) => value);

const displayProducts = filtered.map((product) => {
  const categories = cleanValues(product.categories || [product.category]);
  const subcategories = cleanValues(product.subcategories || [product.subcategory]);
  const countries = cleanValues(product.grownIn || []);
  const certifications = cleanValues(product.certifications || []);
  const availableStock = Math.max(0, Number(product.availableStock ?? 0));
  const lowStockThreshold = Math.max(0, Number(product.lowStockThreshold ?? 5));
  const outOfStock = product.available === false || availableStock < 1;
  const lowStock = !outOfStock && availableStock <= lowStockThreshold;
  const nutritionRows = nutritionRowsFor(product);
  const origin = String(product.origin || '').trim();
  const sourceValue = Number(product.sourceValue || 0);
  const commonsBalance = Number(product.priceNumber || 0) - sourceValue;
  const hasPriceBreakdown = Boolean(product.sourceValueRecipientName && sourceValue > 0);
  const hasDetails = Boolean(product.expandedDescription || product.description || product.ingredients || product.allergens || product.mayContain || product.storage || product.fboImporter || product.origin || product.secondaryOrigin || nutritionRows.length);
  return { ...product, categories, subcategories, countries, certifications, availableStock, outOfStock, lowStock, nutritionRows, origin, sourceValue, commonsBalance, hasPriceBreakdown, hasDetails };
});
---
<div class="product-grid" style={`--columns:${columns}`}>
  {displayProducts.map((product) => (
    <article
      class:list={["product-card", {"product-card-out-of-stock":product.outOfStock,"product-card-low-stock":product.lowStock}]}
      data-product-card
      data-categories={product.categories.join('|')}
      data-primary-category={product.category || product.categories[0] || ''}
      data-subcategories={product.subcategories.join('|')}
      data-name={String(product.name || '').toLowerCase()}
      data-search={[product.name, product.description, product.expandedDescription, ...product.categories, ...product.subcategories, ...product.countries].filter(Boolean).join(' ').toLowerCase()}
      data-id={product.id}
      data-price={product.priceNumber}
      data-popularity={product.popularity ?? product.order ?? 9999}
      data-country={product.countries[0] || ''}
      data-stock={product.availableStock}
      data-out-of-stock={product.outOfStock ? 'true' : 'false'}
    >
      {product.hasDetails
        ? <button class="product-image-button" type="button" data-open-product aria-label={`More information about ${product.name}`}><img src={product.image || '/images/placeholder.svg'} alt="" loading="lazy" /></button>
        : <img src={product.image || '/images/placeholder.svg'} alt="" loading="lazy" />}
      <div class="product-copy">
        <div class="product-title-row">
          <h3>{product.hasDetails ? <button type="button" class="product-title-button" data-open-product>{product.name}</button> : product.name}</h3>
        </div>
        {product.size && <p class="product-size">{product.size}</p>}
        {(product.origin || product.secondaryOrigin) && <p class="product-origin">{[product.origin, product.secondaryOrigin].filter(Boolean).join(', ')}.</p>}
        <p class="stock-warning stock-warning-out" data-stock-out hidden={!product.outOfStock}>Out of stock</p>
        <p class="stock-warning" data-stock-low hidden={!product.lowStock}>Low stock — <span data-stock-count>{product.availableStock}</span> left</p>

        {product.certifications.length > 0 && <div class="product-certifications" aria-label="Certifications">
          {product.certifications.map((certification) => {
            const logo = certificationLogos[String(certification).toLowerCase()];
            return logo
              ? <img class="certification-logo" src={logo} alt={certification} title={certification} loading="lazy" />
              : <span class="certification-text" title={certification}>{certification}</span>;
          })}
        </div>}

        <div class="product-transaction-row">
          <div class="product-price-with-info">
            <strong class="product-price">{money.format(product.priceNumber || 0)}</strong>
            {product.hasPriceBreakdown && <button class="price-card-info-toggle" type="button" data-price-breakdown-toggle aria-expanded="false" aria-label="See where your money goes" title="Where your money goes">ⓘ</button>}
          </div>
          {showControls && <div class="quantity-control quantity-control-solid" data-quantity-control hidden={product.outOfStock} aria-label={`Quantity of ${product.name}`}>
            <button type="button" data-quantity-change="-1" aria-label="Remove one">−</button>
            <output data-quantity>0</output>
            <button type="button" data-quantity-change="1" aria-label="Add one">+</button>
          </div>}
        </div>
        {product.hasPriceBreakdown && <section class="price-breakdown-card" data-price-breakdown hidden aria-label="Where your money goes">
          <div data-price-breakdown-main>
            <h4>Where your money goes</h4>
            <dl class="price-breakdown-list">
              <div>
                <dt>
                  <button class="price-breakdown-label" type="button" data-price-help-toggle="source" aria-expanded="false">
                    <span>{product.sourceValueRecipientName}</span><span class="price-info-icon" aria-hidden="true">ⓘ</span>
                  </button>
                </dt>
                <dd>{pounds(product.sourceValue)}</dd>
              </div>
              {Math.abs(product.commonsBalance) >= 0.005 && <div>
                <dt>
                  <button class="price-breakdown-label" type="button" data-price-help-toggle="commons" aria-expanded="false">
                    <span>{product.commonsBalance > 0 ? 'Commons contribution' : 'Commons subsidy'}</span><span class="price-info-icon" aria-hidden="true">ⓘ</span>
                  </button>
                </dt>
                <dd>{pounds(product.commonsBalance)}</dd>
              </div>}
              <div class="price-breakdown-total">
                <dt>
                  <button class="price-breakdown-label" type="button" data-price-help-toggle="member" aria-expanded="false">
                    <strong>Member price</strong><span class="price-info-icon" aria-hidden="true">ⓘ</span>
                  </button>
                </dt>
                <dd><strong>{pounds(product.priceNumber)}</strong></dd>
              </div>
            </dl>
          </div>
          <div class="price-help-panel" data-price-help="source" hidden>
            <button class="price-help-back" type="button" data-price-help-back>← Back to price breakdown</button>
            <h4>{product.sourceValueRecipientName}</h4>
            <div class="price-help-copy">
              <p data-price-source-help data-partner-id={product.sourceValueRecipientId || ''} data-help-key="price_breakdown.source_help">{content['price_breakdown.source_help'] || 'This is the average price Rooted Commons has paid the producer or wholesaler for the stock currently on our shelves. By pooling members’ purchasing power, we can place larger orders and access better wholesale prices while preserving producer value.'}</p>
              <a data-price-partner-link href={`/our-network/?partner=${encodeURIComponent(String(product.sourceValueRecipientId || ''))}`} target="_blank" rel="noopener noreferrer">{content['price_breakdown.partner_link_label'] || `Learn more about ${product.sourceValueRecipientName} →`}</a>
            </div>
          </div>
          {Math.abs(product.commonsBalance) >= 0.005 && <div class="price-help-panel" data-price-help="commons" hidden>
            <button class="price-help-back" type="button" data-price-help-back>← Back to price breakdown</button>
            <h4>{product.commonsBalance > 0 ? 'Commons contribution' : 'Commons subsidy'}</h4>
            <div class="price-help-copy">
              <p data-help-key={product.commonsBalance > 0 ? 'price_breakdown.contribution_help' : 'price_breakdown.subsidy_help'}>{product.commonsBalance > 0
                ? (content['price_breakdown.contribution_help'] || 'The difference between what Rooted Commons pays for this product and its member price. Contributions from across the market help fund the shared storage, packing, administration and distribution behind Rooted Commons.')
                : (content['price_breakdown.subsidy_help'] || 'This product costs Rooted Commons more than its member price. The difference is funded by contributions generated elsewhere in the commons, helping us keep selected products affordable.')}</p>
              <a href={content['price_breakdown.commons_link_url'] || '/faqs/'} target="_blank" rel="noopener noreferrer" data-help-link="commons">{content['price_breakdown.commons_link_label'] || 'Learn more in FAQs →'}</a>
            </div>
          </div>}
          <div class="price-help-panel" data-price-help="member" hidden>
            <button class="price-help-back" type="button" data-price-help-back>← Back to price breakdown</button>
            <h4>Member price</h4>
            <div class="price-help-copy">
              <p data-help-key="price_breakdown.member_price_help">{content['price_breakdown.member_price_help'] || 'For cupboard staples, member prices are benchmarked against comparable supermarket own-brand organic products. Pooling purchasing power lets Rooted Commons offer organic staples at supermarket prices, or less, while supporting the shared infrastructure behind the commons.'}</p>
            </div>
          </div>
        </section>}
      </div>
      {product.hasDetails && <template data-product-detail>
        <div class="product-detail-layout product-detail-information-layout">
          <div class="product-detail-copy">
            <h2>{product.name}{product.size ? ` – ${product.size}` : ''}</h2>
            {product.image && <figure class="product-detail-image"><img src={product.image} alt={product.name} /></figure>}
            {product.origin && <p class="product-detail-origin"><strong>Origin</strong><span>{product.origin}</span></p>}
            {product.secondaryOrigin && <p class="product-detail-origin"><strong>Secondary origin</strong><span>{product.secondaryOrigin}</span></p>}
            {(product.expandedDescription || product.description) && <FormattedText text={product.expandedDescription || product.description} class="product-detail-overview rich-body" />}
            {product.ingredients && <section><h3>Ingredients</h3><p class="rich-body" data-ingredients data-allergens={product.allergens}>{product.ingredients}</p></section>}
            {product.mayContain && <section><h3>May contain</h3><FormattedText text={product.mayContain} class="rich-body" /></section>}
            {product.storage && <section><h3>How to store / once opened</h3><FormattedText text={product.storage} class="rich-body" /></section>}
            {product.fboImporter && <section><h3>FBO / importer</h3><FormattedText text={product.fboImporter} class="rich-body" /></section>}
            <p class="product-detail-note">Product information can change. Always check the pack before use, particularly for allergens.</p>
          </div>
          {product.nutritionRows.length > 0 && <aside class="nutrition-section product-detail-nutrition">
            <h3>Nutrition</h3>
            <table class="nutrition-table">
              <thead><tr><th scope="col">Typical values</th><th scope="col">{product.nutritionBasis || 'Per 100 g'}</th></tr></thead>
              <tbody>{product.nutritionRows.map(([label, value]) => <tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody>
            </table>
          </aside>}
        </div>
      </template>}
    </article>
  ))}
</div>
{displayProducts.length === 0 && <p>No products currently match this section.</p>}

<script>
(() => {
  if (window.__rootedPriceBreakdownReady) return;
  window.__rootedPriceBreakdownReady = true;

  const showBreakdownMain = (box) => {
    if (!box) return;
    const main = box.querySelector('[data-price-breakdown-main]');
    if (main) main.hidden = false;
    box.querySelectorAll('[data-price-help]').forEach((panel) => { panel.hidden = true; });
    box.querySelectorAll('[data-price-help-toggle]').forEach((button) => button.setAttribute('aria-expanded', 'false'));
  };

  const closeBreakdowns = (exceptCard = null) => {
    document.querySelectorAll('[data-product-card]').forEach((card) => {
      if (exceptCard && card === exceptCard) return;
      const box = card.querySelector('[data-price-breakdown]');
      const toggle = card.querySelector('[data-price-breakdown-toggle]');
      if (box) {
        box.hidden = true;
        showBreakdownMain(box);
      }
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    });
  };

  const positionBreakdown = (toggle, box, card) => {
    if (!toggle || !box || !card) return;
    if (window.matchMedia('(max-width:650px)').matches) {
      box.style.removeProperty('--breakdown-left');
      box.style.removeProperty('--breakdown-top');
      return;
    }
    const buttonRect = toggle.getBoundingClientRect();
    const cardRect = card.getBoundingClientRect();
    const width = Math.min(340, Math.max(250, window.innerWidth - 32));
    let viewportLeft = buttonRect.left + buttonRect.width / 2 - width / 2;
    viewportLeft = Math.max(16, Math.min(viewportLeft, window.innerWidth - width - 16));
    const left = viewportLeft - cardRect.left;
    box.style.setProperty('--breakdown-left', `${left}px`);
    box.style.setProperty('--breakdown-top', `${buttonRect.bottom - cardRect.top + 8}px`);
    box.style.setProperty('--breakdown-width', `${width}px`);
  };

  document.addEventListener('click', (event) => {
    const breakdownToggle = event.target.closest('[data-price-breakdown-toggle]');
    if (breakdownToggle) {
      event.preventDefault();
      event.stopPropagation();
      const card = breakdownToggle.closest('[data-product-card]');
      const box = card?.querySelector('[data-price-breakdown]');
      if (!box) return;
      const opening = box.hidden;
      if (opening) {
        closeBreakdowns(card);
        showBreakdownMain(box);
        positionBreakdown(breakdownToggle, box, card);
      }
      box.hidden = !opening;
      breakdownToggle.setAttribute('aria-expanded', opening ? 'true' : 'false');
      return;
    }

    const helpToggle = event.target.closest('[data-price-help-toggle]');
    if (helpToggle) {
      event.preventDefault();
      event.stopPropagation();
      const box = helpToggle.closest('[data-price-breakdown]');
      const panel = box?.querySelector(`[data-price-help="${helpToggle.dataset.priceHelpToggle}"]`);
      const main = box?.querySelector('[data-price-breakdown-main]');
      if (!panel || !main) return;
      main.hidden = true;
      box.querySelectorAll('[data-price-help]').forEach((candidate) => candidate.hidden = candidate !== panel);
      box.querySelectorAll('[data-price-help-toggle]').forEach((button) => button.setAttribute('aria-expanded', button === helpToggle ? 'true' : 'false'));
      panel.hidden = false;
      return;
    }

    const back = event.target.closest('[data-price-help-back]');
    if (back) {
      event.preventDefault();
      event.stopPropagation();
      showBreakdownMain(back.closest('[data-price-breakdown]'));
      return;
    }

    if (event.target.closest('[data-price-breakdown]')) return;
    closeBreakdowns();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeBreakdowns();
  });

  window.addEventListener('resize', () => closeBreakdowns());

  const applyPartnerHelp = (data = {}) => {
    const partners = data.partners || [];
    document.querySelectorAll('[data-price-source-help][data-partner-id]').forEach((element) => {
      const partner = partners.find((item) => Number(item.id) === Number(element.dataset.partnerId));
      if (partner?.priceExplanation) {
        element.textContent = partner.priceExplanation;
        element.dataset.partnerHelpActive = 'true';
      }
    });
  };

  const applyInterfaceHelp = (content = {}) => {
    document.querySelectorAll('[data-help-key]').forEach((element) => {
      if (element.dataset.partnerHelpActive === 'true') return;
      const value = content[element.dataset.helpKey];
      if (value) element.textContent = value;
    });
    document.querySelectorAll('[data-help-link="commons"]').forEach((link) => {
      if (content['price_breakdown.commons_link_url']) link.href = content['price_breakdown.commons_link_url'];
      if (content['price_breakdown.commons_link_label']) link.textContent = content['price_breakdown.commons_link_label'];
    });
    document.querySelectorAll('[data-price-partner-link]').forEach((link) => {
      if (content['price_breakdown.partner_link_label']) link.textContent = content['price_breakdown.partner_link_label'];
    });
    if (window.__rootedPublicNetwork) applyPartnerHelp(window.__rootedPublicNetwork);
  };

  window.addEventListener('rooted:public-content', (event) => applyInterfaceHelp(event.detail?.interfaceContent || {}));
  window.addEventListener('rooted:public-network', (event) => applyPartnerHelp(event.detail || {}));
  if (window.__rootedPublicContent) applyInterfaceHelp(window.__rootedPublicContent.interfaceContent || {});
  if (window.__rootedPublicNetwork) applyPartnerHelp(window.__rootedPublicNetwork);
})();
</script>
