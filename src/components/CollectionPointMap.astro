---
const { points = [] } = Astro.props;
const mapPoints = points
  .filter((point) => Number.isFinite(Number(point.latitude)) && Number.isFinite(Number(point.longitude)))
  .map((point) => ({
    id: point.id,
    name: point.name,
    address: point.address,
    latitude: Number(point.latitude),
    longitude: Number(point.longitude),
    collectionSlots: point.collectionSlots || [],
    image: point.image || ''
  }));
---
<section class="collection-map-section" aria-label="Collection point map">
  <button id="collection-map-back" class="button collection-map-back" type="button">← Back</button>
  {mapPoints.length ? (
    <div id="collection-point-map" class="collection-point-map" role="region" aria-label="Map of Rooted Commons collection points"></div>
  ) : (
    <div class="collection-map-empty">
      <p>Collection-point locations will appear here once latitude and longitude have been added in Baserow.</p>
    </div>
  )}
</section>

{mapPoints.length > 0 && (
  <script is:inline define:vars={{ mapPoints }}>
    (()=>{
      const mapEl=document.getElementById('collection-point-map');
      if(!mapEl)return;
      const params=new URLSearchParams(window.location.search);
      const returnPath=params.get('return')||'';
      const selectionMode=params.get('select')==='1';
      localStorage.removeItem('rooted-commons-order-token-v1');
      const urlToken=params.get('token')||'';
      if(urlToken)location.replace(`/api/access?token=${encodeURIComponent(urlToken)}&return=${encodeURIComponent(location.pathname+location.search.replace(/([?&])token=[^&]*&?/,'$1').replace(/[?&]$/,''))}`);
      let memberAuthenticated=false;
      const backButton=document.getElementById('collection-map-back');
      backButton?.addEventListener('click',()=>{
        if(window.history.length>1)window.history.back();
        else window.location.href=returnPath||'/';
      });

      const initialise=async()=>{
        if(!window.L)return;
        const livePoints=mapPoints;
        if(!selectionMode){try{memberAuthenticated=(await (window.RootedData?.authStatus?.() || fetch('/api/auth-status',{cache:'no-store'}))).ok;}catch{memberAuthenticated=false;}}
        const canSelect=selectionMode||memberAuthenticated;
        const map=L.map(mapEl,{scrollWheelZoom:false});
        const bounds=[];
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{
          maxZoom:19,
          attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
        }).addTo(map);


        const escapeHtml=(value)=>String(value||'').replace(/[&<>'"]/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
        livePoints.forEach(point=>{
          const coords=[Number(point.latitude),Number(point.longitude)];
          bounds.push(coords);
          const slots=(point.collectionSlots||[]).map(slot=>`<li><strong>${escapeHtml(slot.day)}</strong> · ${escapeHtml(slot.time)}</li>`).join('');
          const image=point.image?`<img class="map-popup-image" src="${escapeHtml(point.image)}" alt="" loading="lazy">`:'';
          const selectButton=canSelect?`<button class="map-select-button" type="button" data-map-select-point="${Number(point.id)}">Select collection point</button><p class="map-select-status" data-map-select-status="${Number(point.id)}" hidden></p>`:'';
          const popup=`<div class="map-popup">${image}<strong>${escapeHtml(point.name)}</strong>${point.address?`<p>${escapeHtml(point.address).replace(/\n/g,'<br>')}</p>`:''}${slots?`<ul>${slots}</ul>`:''}${selectButton}</div>`;
          L.marker(coords).addTo(map).bindPopup(popup);
        });

        map.on('popupopen',event=>{
          const root=event.popup.getElement();
          const button=root?.querySelector('[data-map-select-point]');
          if(!button)return;
          button.addEventListener('click',async()=>{
            const pointId=Number(button.dataset.mapSelectPoint);
            const status=root.querySelector(`[data-map-select-status="${pointId}"]`);
            button.disabled=true;
            try{
              if(selectionMode){
                localStorage.setItem('rooted-commons-signup-collection-point',String(pointId));
                window.location.href=returnPath||'/signup/';
                return;
              }
              if(memberAuthenticated){
                const current=await (window.RootedData?.member?.() || fetch('/api/member',{cache:'no-store'})).then(r=>r.json());
                const preferred=current?.member?.preferredCollectionDay||'Thursday';
                const response=await fetch('/api/member',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({collectionPointId:pointId,preferredCollectionDay:preferred})});
                window.RootedData?.invalidate?.('member');
                const payload=await response.json();
                if(!response.ok)throw new Error(payload.message||'Could not update collection point.');
                if(status){status.hidden=false;status.textContent='Collection point updated.';}
                button.textContent='Selected';
                return;
              }
            }catch(error){
              if(status){status.hidden=false;status.textContent=error.message||'Could not update collection point.';}
              button.disabled=false;
            }
          },{once:true});
        });

        if(bounds.length===1)map.setView(bounds[0],13);
        else map.fitBounds(bounds,{padding:[32,32],maxZoom:13});
      };
      if(window.L){initialise();return;}
      const script=document.createElement('script');
      script.src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      script.integrity='sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=';
      script.crossOrigin='';
      script.onload=initialise;
      document.head.appendChild(script);
    })();
  </script>
)}
