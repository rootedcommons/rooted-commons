---
import FormattedText from './FormattedText.astro';
const { settings, pages } = Astro.props;
const links = Array.isArray(settings.navigationLinks) && settings.navigationLinks.length
  ? settings.navigationLinks
  : pages.filter((page) => !['home','checkout'].includes(page.slug)).slice(0,5).map((page, index) => ({ order:index+1, label:page.title, url:`/${page.slug}/` }));
---
<div class="site-header-shell">
  <header data-live-header class={`site-header height-${settings.headerHeight}`}>
    <a data-live-header-logo class={`brand logo-${settings.headerLogoSize}`} href="/" aria-label={`${settings.siteTitle} home`}>
      {settings.headerLogo ? <img src={settings.headerLogo} alt={settings.siteTitle} /> : <span>{settings.siteTitle}</span>}
    </a>
    <nav id="site-navigation" data-live-navigation class={`text-${settings.navigationTextSize}`} aria-label="Main navigation">
      {links.map((link) => <a href={link.url}>{link.label}</a>)}
    </nav>
    <div class="header-actions">
      <div class="header-actions-top">
        <a id="auth-header-button" class="header-auth-link" href="/signin/">Sign in</a>
        <button class="mobile-nav-toggle" type="button" aria-controls="site-navigation" aria-expanded="false" aria-label="Open navigation menu">
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
      </div>
      <a data-live-header-cta id="membership-header-button" class={`button header-cta button-${settings.buttonTextSize}`} href={settings.headerButtonUrl || settings.joinButtonUrl || '/volunteering/'}>
        {settings.headerButtonText || settings.joinButtonText || 'Join our growing network'}
      </a>
    </div>
  </header>
</div>
{settings.headerText && <div data-live-header-text><FormattedText text={settings.headerText} class="header-message" /></div>}

<script is:inline>
  (() => {
    localStorage.removeItem('rooted-commons-order-token-v1');
    const button=document.querySelector('#membership-header-button');
    const authButton=document.querySelector('#auth-header-button');
    const setMemberHeaderState=(signedIn)=>{
      if(!button||!authButton)return;
      document.documentElement.dataset.memberAuth=signedIn?'in':'out';
      if(signedIn){
        button.textContent='My Membership';
        button.setAttribute('href','/dashboard/');
        authButton.textContent='Sign out';
        authButton.setAttribute('href','/api/signout');
      }else{
        button.textContent=button.dataset.loggedOutText||button.textContent||'Become a member';
        button.setAttribute('href',button.dataset.loggedOutUrl||button.getAttribute('href')||'/signup/');
        authButton.textContent='Sign in';
        authButton.setAttribute('href','/signin/');
      }
    };
    if(button&&authButton){
      button.dataset.loggedOutText=button.textContent.trim();
      button.dataset.loggedOutUrl=button.getAttribute('href')||'/signup/';
      window.__rootedMemberStatePromise=window.__rootedMemberStatePromise||fetch('/api/member').then(response=>response.ok).catch(()=>false);
      window.__rootedMemberStatePromise.then(setMemberHeaderState);
      window.addEventListener('rooted:public-content',()=>{
        if(document.documentElement.dataset.memberAuth==='in')setMemberHeaderState(true);
      });
    }

    const header=document.querySelector('.site-header');
    const nav=document.querySelector('#site-navigation');
    const toggle=document.querySelector('.mobile-nav-toggle');
    if(!header||!nav||!toggle)return;

    const setOpen=(open)=>{
      header.classList.toggle('mobile-nav-open',open);
      toggle.setAttribute('aria-expanded',String(open));
      toggle.setAttribute('aria-label',open?'Close navigation menu':'Open navigation menu');
    };

    toggle.addEventListener('click',()=>setOpen(toggle.getAttribute('aria-expanded')!=='true'));
    nav.addEventListener('click',(event)=>{
      if(event.target.closest('a'))setOpen(false);
    });
    document.addEventListener('keydown',(event)=>{
      if(event.key==='Escape')setOpen(false);
    });
  })();
</script>
