---
import FormattedText from './FormattedText.astro';
const { page } = Astro.props;
const layout = page.heroLayout || (page.heroImage ? 'text-left' : 'text-only');
const hidden = layout === 'none';
const hasImage = Boolean(page.heroImage) && !['text-only','none'].includes(layout);
const alignment = page.heroAlignment || 'left';
const padding = page.heroPadding || 'normal';
const width = page.heroWidth || 'standard';
const gap = page.heroGap || 'normal';
const imageShape = page.heroImageShape || 'landscape';
---
{!hidden && (
  <section class={`page-hero layout-${layout} hero-align-${alignment} hero-padding-${padding} hero-width-${width} hero-gap-${gap}`}>
    <div class="hero-copy">
      <h1 class={`size-${page.titleSize}`}>{page.title}</h1>
      {page.subtitle && <p class={`hero-subtitle size-${page.subtitleSize}`}>{page.subtitle}</p>}
      {page.intro && <FormattedText text={page.intro} class={`hero-intro size-${page.introSize}`} />}
      {page.buttonText && page.buttonUrl && <a class="button" href={page.buttonUrl}>{page.buttonText}</a>}
    </div>
    {hasImage && <figure class={`hero-media hero-image-shape-${imageShape} fit-${page.heroImageFit} position-${page.heroImageAlignment}`}>
      <img src={page.heroImage} alt="" />
    </figure>}
  </section>
)}
