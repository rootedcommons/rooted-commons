---
import ProductGrid from './ProductGrid.astro';
import FormattedText from './FormattedText.astro';
import CardGallery from './CardGallery.astro';
import NetworkGrid from './NetworkGrid.astro';
const { block, products, settings, networkPartners = [], metrics = [] } = Astro.props;
const section = block.section;
const type = block.type;
const background = `background-${section.backgroundStyle}`;
const spaces = `space-above-${section.spaceAbove} space-below-${section.spaceBelow}`;
const alignment = `align-${section.alignment}`;
const headingAlignment = `align-${section.headingAlignment || section.alignment}`;
const button = section.buttonVisible && section.buttonText && section.buttonUrl;
const groupTitle = block.items.find((item) => item.groupHeading)?.groupHeading || (block.key === 'how-it-works' ? 'How it works' : '');
const isHowItWorksCarousel = type === 'cards' && block.key === 'how-it-works';
const inferredGridCategory = section.gridCategory || (section.page === 'cupboard-staples' ? 'Cupboard Staples' : section.page === 'fresh-produce' ? 'Fresh Produce' : section.page === 'refills' ? 'Refills' : '');

const selectedMetrics = metrics.filter((metric) =>
  (section.metricIds || []).includes(metric.id) || (section.metricNames || []).includes(metric.name)
);
const metricHeadline = (metric) => metric.displayValue || (metric.value !== null && metric.value !== undefined
  ? `${metric.value.toLocaleString('en-GB')}${metric.unit ? ` ${metric.unit}` : ''}`
  : metric.valueText || '');
const selectedProducts = (section.productIds || []).length
  ? products.filter((product) => section.productIds.includes(product.id))
  : products;
---
{type === 'text' && (
  <section data-live-section-id={section.id} data-live-section-key={section.key || block.key || ''} class={`content-section text-section ${background} ${spaces} ${alignment}`}>
    <div class="section-inner prose-width">
      {section.eyebrow && <p data-live-section-field="eyebrow" class="eyebrow">{section.eyebrow}</p>}
      {section.heading && <h2 data-live-section-field="heading" class={`${headingAlignment} size-${section.headingSize}`}>{section.heading}</h2>}
      {section.subheading && <p data-live-section-field="subheading" class={`section-subheading size-${section.subheadingSize}`}>{section.subheading}</p>}
      {section.body && <div data-live-section-rich="body"><FormattedText text={section.body} class={`rich-body size-${section.bodySize}`} /></div>}
      {button && <a data-live-section-button class={`button button-${section.buttonSize}`} href={section.buttonUrl}>{section.buttonText}</a>}
    </div>
  </section>
)}

{type === 'image-and-text' && (
  <section data-live-section-id={section.id} data-live-section-key={section.key || block.key || ''} class={`content-section split-section image-${section.imagePosition} ${background} ${spaces} ${alignment}`}>
    <div class="section-inner split-inner">
      {section.image && <figure data-live-section-image class={`section-media image-size-${section.imageSize} fit-${section.imageFit}`}>
        <img data-live-section-image-img src={section.image} alt={section.imageAlt || ''} loading="lazy" />
        {section.imageCaption && <figcaption>{section.imageCaption}</figcaption>}
      </figure>}
      <div class="section-copy">
        {section.eyebrow && <p data-live-section-field="eyebrow" class="eyebrow">{section.eyebrow}</p>}
        {section.heading && <h2 data-live-section-field="heading" class={`${headingAlignment} size-${section.headingSize}`}>{section.heading}</h2>}
        {section.subheading && <p data-live-section-field="subheading" class={`section-subheading size-${section.subheadingSize}`}>{section.subheading}</p>}
        {section.body && <div data-live-section-rich="body"><FormattedText text={section.body} class={`rich-body size-${section.bodySize}`} /></div>}
        </div>
        {button && <a data-live-section-button class={`button cta-button button-${section.buttonSize}`} href={section.buttonUrl}>{section.buttonText}</a>}
      </div>
    </div>
  </section>
)}

{type === 'banner' && (
  <section data-live-section-id={section.id} data-live-section-key={section.key || block.key || ''} class={`banner-section ${background} ${spaces} ${alignment} image-size-${section.imageSize}`} style={section.image ? `background-image:linear-gradient(rgba(0,0,0,.28),rgba(0,0,0,.28)),url(${section.image})` : undefined}>
    <div class="banner-copy">
      {section.eyebrow && <p data-live-section-field="eyebrow" class="eyebrow">{section.eyebrow}</p>}
      {section.heading && <h2 data-live-section-field="heading" class={`${headingAlignment} size-${section.headingSize}`}>{section.heading}</h2>}
      {section.subheading && <p data-live-section-field="subheading" class={`section-subheading size-${section.subheadingSize}`}>{section.subheading}</p>}
      {section.body && <div data-live-section-rich="body"><FormattedText text={section.body} class={`rich-body size-${section.bodySize}`} /></div>}
      {button && <a data-live-section-button class={`button button-${section.buttonSize}`} href={section.buttonUrl}>{section.buttonText}</a>}
    </div>
  </section>
)}

{type === 'cards' && (
  <section data-live-section-id={section.id} data-live-section-key={section.key || block.key || ''} class={`content-section cards-section ${isHowItWorksCarousel ? 'cards-mobile-carousel' : ''} ${background} ${spaces}`} data-card-carousel={isHowItWorksCarousel ? 'true' : undefined}>
    <div class="section-inner">
      {groupTitle && <h2 class={`group-heading ${headingAlignment} size-${section.headingSize}`}>{groupTitle}</h2>}
      {section.subheading && <p class={`group-subheading align-${section.alignment} size-${section.subheadingSize}`}>{section.subheading}</p>}
      <div class="cards-grid" data-card-carousel-track={isHowItWorksCarousel ? 'true' : undefined} style={`--columns:${section.columns}`}>
        {block.items.map((item) => (
          <article data-live-card-id={item.id} data-card-carousel-slide={isHowItWorksCarousel ? 'true' : undefined} class={`content-card align-${item.alignment}`}>
            {(item.image || item.image2 || item.image3) && <CardGallery
              images={[
                { src: item.image, alt: item.imageAlt },
                { src: item.image2, alt: item.image2Alt },
                { src: item.image3, alt: item.image3Alt }
              ]}
              imageSize={item.imageSize}
              imageFit={item.imageFit}
              caption={item.imageCaption}
            />}
            {item.eyebrow && <p data-live-card-field="eyebrow" class="eyebrow">{item.eyebrow}</p>}
            {item.heading && <h3 data-live-card-field="heading" class={`size-${item.headingSize}`}>{item.heading}</h3>}
            {item.subheading && <p data-live-card-field="subheading" class={`section-subheading size-${item.subheadingSize}`}>{item.subheading}</p>}
            {item.body && <div data-live-card-rich="body"><FormattedText text={item.body} class={`rich-body size-${item.bodySize}`} /></div>}
            {item.buttonVisible && item.buttonText && item.buttonUrl && <a data-live-card-button class={`text-link button-${item.buttonSize}`} href={item.buttonUrl}>{item.buttonText}</a>}
          </article>
        ))}
      </div>
      {isHowItWorksCarousel && <div class="cards-carousel-dots" aria-hidden="true">{block.items.map((_, index) => <span class={`cards-carousel-dot${index === 0 ? ' active' : ''}`} data-card-carousel-dot></span>)}</div>}
    </div>
  </section>
)}

{type === 'stats' && (
  <section data-live-section-id={section.id} data-live-section-key={section.key || block.key || ''} class={`content-section stats-section ${background} ${spaces}`}>
    <div class="section-inner">
      {section.eyebrow && <p data-live-section-field="eyebrow" class={`eyebrow ${alignment}`}>{section.eyebrow}</p>}
      {(section.heading || groupTitle) && <h2 data-live-section-field="heading" class={`group-heading ${headingAlignment} size-${section.headingSize}`}>{section.heading || groupTitle}</h2>}
      {section.subheading && <p data-live-section-field="subheading" class={`group-subheading ${alignment} size-${section.subheadingSize}`}>{section.subheading}</p>}
      {section.body && <div data-live-section-rich="body"><FormattedText text={section.body} class={`rich-body ${alignment} size-${section.bodySize}`} /></div>}
      <div class="stats-grid" data-live-metrics data-section-id={section.id} data-section-key={section.key || ''} data-metric-ids={(section.metricIds || []).join(',')} data-metric-names={(section.metricNames || []).join('|')} style={`--columns:${section.columns}`}>
        {selectedMetrics.length > 0 ? selectedMetrics.map((metric) => (
          <article class="stat-tile align-center">
            {metric.icon && <img class="impact-stat-icon" src={metric.icon} alt="" aria-hidden="true" />}
            <strong class="stat-number">{metricHeadline(metric)}</strong>
            {metric.description && <small class="stat-description">{metric.description}</small>}
          </article>
        )) : block.items.map((item) => (
          <div class={`stat-tile align-${item.alignment}`}>
            <strong class="stat-number">{item.heading}</strong>
            <span class="stat-label">{item.subheading}</span>
          </div>
        ))}
      </div>
      {button && <p class={alignment}><a data-live-section-button class={`button button-${section.buttonSize}`} href={section.buttonUrl}>{section.buttonText}</a></p>}
    </div>
  </section>
)}

{type === 'network' && (
  <section data-live-section-id={section.id} data-live-section-key={section.key || block.key || ''} class={`content-section network-section ${background} ${spaces}`}>
    <div class="section-inner">
      {section.eyebrow && <p data-live-section-field="eyebrow" class={`eyebrow ${alignment}`}>{section.eyebrow}</p>}
      {section.heading && <h2 data-live-section-field="heading" class={`${headingAlignment} size-${section.headingSize}`}>{section.heading}</h2>}
      {section.subheading && <p data-live-section-field="subheading" class={`section-subheading ${alignment} size-${section.subheadingSize}`}>{section.subheading}</p>}
      {section.body && <div data-live-section-rich="body"><FormattedText text={section.body} class={`rich-body ${alignment} size-${section.bodySize}`} /></div>}
      <NetworkGrid partners={networkPartners} metrics={metrics} columns={section.columns} />
      {button && <p class={alignment}><a data-live-section-button class={`button button-${section.buttonSize}`} href={section.buttonUrl}>{section.buttonText}</a></p>}
    </div>
  </section>
)}

{type === 'grid' && (
  <section data-live-section-id={section.id} data-live-section-key={section.key || block.key || ''} class={`content-section grid-section ${background} ${spaces}`}>
    <div class="section-inner">
      {section.eyebrow && <p data-live-section-field="eyebrow" class={`eyebrow ${alignment}`}>{section.eyebrow}</p>}
      {section.heading && <h2 data-live-section-field="heading" class={`${headingAlignment} size-${section.headingSize}`}>{section.heading}</h2>}
      {section.subheading && <p data-live-section-field="subheading" class={`section-subheading ${alignment} size-${section.subheadingSize}`}>{section.subheading}</p>}
      {section.body && <div data-live-section-rich="body"><FormattedText text={section.body} class={`rich-body ${alignment} size-${section.bodySize}`} /></div>}
      <ProductGrid products={selectedProducts} category={inferredGridCategory} columns={section.columns} settings={settings} />
      {button && <p class={alignment}><a data-live-section-button class={`button button-${section.buttonSize}`} href={section.buttonUrl}>{section.buttonText}</a></p>}
    </div>
  </section>
)}

{type === 'call-to-action' && (
  <section data-live-section-id={section.id} data-live-section-key={section.key || block.key || ''} class={`content-section cta-section ${background} ${spaces} ${alignment} ${section.image ? `cta-with-image image-${section.imagePosition}` : ''}`}>
    <div class={`section-inner ${section.image ? 'cta-inner' : 'prose-width'}`}>
      {section.watermarkImage && <div class="cta-watermark" style={`background-image:url("${section.watermarkImage}");--watermark-opacity:${section.watermarkOpacity / 100}`} aria-hidden="true"></div>}
      {section.image && <figure class={`cta-media fit-${section.imageFit}`}>
        <img data-live-section-image-img src={section.image} alt={section.imageAlt || ''} loading="lazy" />
      </figure>}
      <div class="cta-copy">
        {section.icon && <figure class="cta-icon" aria-hidden="true"><img src={section.icon} alt="" loading="lazy" /></figure>}
        <div class="cta-text">
          {section.eyebrow && <p data-live-section-field="eyebrow" class="eyebrow section-eyebrow">{(section.eyebrowIcon || settings.eyebrowIcon) && <img class="eyebrow-icon" src={section.eyebrowIcon || settings.eyebrowIcon} alt="" aria-hidden="true" />}<span>{section.eyebrow}</span></p>}
          {section.heading && <h2 data-live-section-field="heading" class={`${headingAlignment} size-${section.headingSize}`}>{section.heading}</h2>}
          {section.subheading && <p data-live-section-field="subheading" class={`section-subheading size-${section.subheadingSize}`}>{section.subheading}</p>}
          {section.body && <div data-live-section-rich="body"><FormattedText text={section.body} class={`rich-body size-${section.bodySize}`} /></div>}
          {section.countdownDate && (
            <div class="campaign-timing">
              {section.preCountdownLabel && <p data-live-section-field="preCountdownLabel" class="campaign-pre-countdown-label">{section.preCountdownLabel}</p>}
              {section.preCountdownText && <div data-live-section-rich="preCountdownText"><FormattedText text={section.preCountdownText} class="campaign-pre-countdown" /></div>}
              <p class="campaign-countdown" data-countdown-date={section.countdownDate} data-countdown-post={section.postCountdownText || ''}>
                <strong class="campaign-countdown-value"></strong>
                <span class="campaign-countdown-post"></span>
              </p>
            </div>
          )}
        </div>
        {button && <a data-live-section-button class={`button cta-button button-${section.buttonSize}`} href={section.buttonUrl}>{section.buttonText}</a>}
      </div>
    </div>
  </section>
)}

{type === 'campaign' && (
  <section data-live-section-id={section.id} data-live-section-key={section.key || block.key || ''} class={`content-section campaign-section ${background} ${spaces} ${alignment}`}>
    <div class="section-inner campaign-inner">
      {section.watermarkImage && <div class="campaign-botanical" style={`background-image:url("${section.watermarkImage}");--watermark-opacity:${section.watermarkOpacity / 100}`} aria-hidden="true"></div>}
      <div class="campaign-copy">
        {section.eyebrow && <p data-live-section-field="eyebrow" class="eyebrow campaign-eyebrow">{(section.eyebrowIcon || settings.eyebrowIcon) && <img class="eyebrow-icon" src={section.eyebrowIcon || settings.eyebrowIcon} alt="" aria-hidden="true" />}<span>{section.eyebrow}</span></p>}
        {section.heading && <h2 data-live-section-field="heading" class={`campaign-heading ${headingAlignment} size-${section.headingSize}`}>{section.heading}</h2>}
        {section.subheading && <p data-live-section-field="subheading" class={`section-subheading size-${section.subheadingSize}`}>{section.subheading}</p>}
        {section.body && <div data-live-section-rich="body"><FormattedText text={section.body} class={`rich-body campaign-body size-${section.bodySize}`} /></div>}
      </div>

      {(section.image || section.image2 || section.image3) && (
        <div class="campaign-images">
          {[
            { src: section.image, alt: section.imageAlt },
            { src: section.image2, alt: section.image2Alt },
            { src: section.image3, alt: section.image3Alt }
          ].filter((image) => image.src).map((image, index) => (
            <figure class={`campaign-image fit-${section.imageFit}`}>
              <img src={image.src} alt={image.alt || `Founder ${[10,25,50][index] || ''} badge`} loading="lazy" />
              <figcaption>
                <strong>{`Founder ${[10,25,50][index] || index + 1}`}</strong>
                <span>{`The first ${[10,25,50][index] || index + 1}`}</span>
              </figcaption>
            </figure>
          ))}
        </div>
      )}

      {(section.countdownDate || button) && (
        <div class="campaign-launch-panel">
          <div class="campaign-launch-copy">
            {(section.preCountdownLabel || section.preCountdownText || section.countdownDate) && (
              <div class="campaign-market-line">
                <span class="campaign-calendar-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M7 2v3M17 2v3M4.5 8.5h15M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/></svg>
                </span>
                <div class="campaign-market-copy">
                  {section.preCountdownLabel && <p data-live-section-field="preCountdownLabel" class="campaign-pre-countdown-label">{section.preCountdownLabel}</p>}
                  {section.preCountdownText && <div data-live-section-rich="preCountdownText"><FormattedText text={section.preCountdownText} class="campaign-pre-countdown" /></div>}
                  {section.countdownDate && (
                    <p class="campaign-countdown" data-countdown-date={section.countdownDate} data-countdown-post={section.postCountdownText || ''}>
                      <strong class="campaign-countdown-value"></strong>
                      <span class="campaign-countdown-post"></span>
                    </p>
                  )}
                </div>
              </div>
            )}
          </div>
          {button && <a data-live-section-button class={`button campaign-button button-${section.buttonSize}`} href={section.buttonUrl}><span>{section.buttonText}</span><span class="campaign-button-arrow" aria-hidden="true">→</span></a>}
        </div>
      )}
    </div>
  </section>
)}

{type === 'gallery' && (
  <section data-live-section-id={section.id} data-live-section-key={section.key || block.key || ''} class={`content-section gallery-section ${background} ${spaces}`}>
    <div class="section-inner">
      {groupTitle && <h2 class={`group-heading ${headingAlignment} size-${section.headingSize}`}>{groupTitle}</h2>}
      <div class="gallery-grid" style={`--columns:${section.columns}`}>
        {block.items.filter((item) => item.image).map((item) => (
          <figure data-live-card-id={item.id} class={`gallery-item image-size-${item.imageSize} fit-${item.imageFit}`}>
            <img src={item.image} alt={item.imageAlt || ''} loading="lazy" />
            {(item.imageCaption || item.heading) && <figcaption>{item.imageCaption || item.heading}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}


<script>
  const initCardCarousels = () => {
    document.querySelectorAll('[data-card-carousel="true"]').forEach((carousel) => {
      if (carousel.dataset.carouselReady) return;
      carousel.dataset.carouselReady = 'true';
      const track = carousel.querySelector('[data-card-carousel-track="true"]');
      const slides = [...carousel.querySelectorAll('[data-card-carousel-slide="true"]')];
      const dots = [...carousel.querySelectorAll('[data-card-carousel-dot]')];
      if (!track || slides.length < 2 || dots.length !== slides.length) return;
      const currentIndex = () => Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / (track.clientWidth || 1))));
      const update = () => dots.forEach((dot, index) => dot.classList.toggle('active', index === currentIndex()));
      let frame = 0;
      track.addEventListener('scroll', () => { cancelAnimationFrame(frame); frame = requestAnimationFrame(update); }, { passive: true });
      update();
    });
  };

  const updateCampaignCountdowns = () => {
    document.querySelectorAll('[data-countdown-date]').forEach((element) => {
      const dateValue = element.getAttribute('data-countdown-date') || '';
      const match = dateValue.match(/^(\d{4})-(\d{2})-(\d{2})/);
      if (!match) return;

      const target = new Date(Number(match[1]), Number(match[2]) - 1, Number(match[3]));
      const today = new Date();
      today.setHours(0, 0, 0, 0);
      target.setHours(0, 0, 0, 0);
      const days = Math.ceil((target.getTime() - today.getTime()) / 86400000);
      const value = element.querySelector('.campaign-countdown-value');
      const post = element.querySelector('.campaign-countdown-post');
      if (!value || !post) return;

      if (days > 1) {
        value.textContent = `${days} days`;
        post.textContent = element.getAttribute('data-countdown-post') || '';
      } else if (days === 1) {
        value.textContent = '1 day';
        post.textContent = element.getAttribute('data-countdown-post') || '';
      } else if (days === 0) {
        value.textContent = 'Today';
        post.textContent = '';
      } else {
        value.textContent = '';
        post.textContent = '';
        element.setAttribute('hidden', '');
      }
    });
  };
  initCardCarousels();
  updateCampaignCountdowns();
  document.addEventListener('astro:page-load', () => { initCardCarousels(); updateCampaignCountdowns(); });
</script>
