---
import FormattedText from './FormattedText.astro';

const { items = [] } = Astro.props;
---

{items.length > 0 && (
  <section class="faq-section" aria-label="Frequently asked questions">
    <div class="faq-list" data-faq-accordion>
      {items.map((item) => (
        <details class="faq-item" id={item.anchor}>
          <summary>
            <span>{item.question}</span>
            <span class="faq-icon" aria-hidden="true"></span>
          </summary>
          <FormattedText text={item.answer} class="faq-answer" />
        </details>
      ))}
    </div>
  </section>
)}

<script>
  const initialiseFaqAccordions = () => {
    document.querySelectorAll('[data-faq-accordion]').forEach((accordion) => {
      const items = Array.from(accordion.querySelectorAll('details'));
      items.forEach((item) => {
        if (item.dataset.faqReady === 'true') return;
        item.dataset.faqReady = 'true';
        item.addEventListener('toggle', () => {
          if (!item.open) return;
          items.forEach((other) => {
            if (other !== item) other.open = false;
          });
        });
      });

      const openHashTarget = () => {
        const id = decodeURIComponent(window.location.hash.replace(/^#/, ''));
        if (!id) return;
        const target = items.find((item) => item.id === id);
        if (!target) return;
        items.forEach((item) => { item.open = item === target; });
        requestAnimationFrame(() => target.scrollIntoView({ block: 'start' }));
      };

      openHashTarget();
      if (accordion.dataset.hashReady !== 'true') {
        accordion.dataset.hashReady = 'true';
        window.addEventListener('hashchange', openHashTarget);
      }
    });
  };

  initialiseFaqAccordions();
  document.addEventListener('astro:page-load', initialiseFaqAccordions);
</script>
