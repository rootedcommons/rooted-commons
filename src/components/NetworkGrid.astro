---
import Icon from './Icon.astro';

const { columns = 2 } = Astro.props;
---

<div class="network-grid" data-network-grid data-live-network style={`--columns:${columns}`}>
  <template data-network-partner-template>
    <article class="network-card" data-network-generated>
      <div class="network-card-media-trigger" data-live-card-media role="button" tabindex="0" hidden>
        <figure class="card-gallery-shell" data-network-gallery>
          <div class="card-gallery image-size-large fit-cover" data-network-gallery-track tabindex="0" aria-label="Image gallery">
            <div class="card-gallery-slide" data-network-image-slot><img data-live-network-image alt="" loading="lazy" /></div>
            <div class="card-gallery-slide" data-network-image-slot><img data-live-network-image alt="" loading="lazy" /></div>
            <div class="card-gallery-slide" data-network-image-slot><img data-live-network-image alt="" loading="lazy" /></div>
          </div>
          <button class="card-gallery-arrow card-gallery-arrow-prev" type="button" data-network-gallery-prev aria-label="Previous image">‹</button>
          <button class="card-gallery-arrow card-gallery-arrow-next" type="button" data-network-gallery-next aria-label="Next image">›</button>
          <div class="card-gallery-dots" data-network-gallery-dots aria-hidden="true">
            <span class="card-gallery-dot active" data-network-image-dot></span>
            <span class="card-gallery-dot" data-network-image-dot></span>
            <span class="card-gallery-dot" data-network-image-dot></span>
          </div>
        </figure>
      </div>
      <div class="network-card-copy">
        <h3><button class="network-card-title" type="button" data-live-card-name></button></h3>
        <p class="network-role" data-live-card-role hidden></p>
        <p data-live-card-summary hidden></p>
        <button class="network-explore" type="button">Learn more <span aria-hidden="true">→</span></button>
      </div>
    </article>

    <dialog class="network-dialog" data-network-dialog data-network-generated>
      <button class="network-dialog-close" type="button" data-network-close aria-label="Close partner">×</button>
      <div class="network-dialog-inner">
        <div class="network-dialog-media" data-live-modal-media hidden>
          <figure class="card-gallery-shell card-gallery-dots-overlay" data-network-gallery>
            <div class="card-gallery image-size-large fit-cover" data-network-gallery-track tabindex="0" aria-label="Image gallery">
              <div class="card-gallery-slide" data-network-image-slot><img data-live-network-image alt="" loading="lazy" /></div>
              <div class="card-gallery-slide" data-network-image-slot><img data-live-network-image alt="" loading="lazy" /></div>
              <div class="card-gallery-slide" data-network-image-slot><img data-live-network-image alt="" loading="lazy" /></div>
            </div>
            <button class="card-gallery-arrow card-gallery-arrow-prev" type="button" data-network-gallery-prev aria-label="Previous image">‹</button>
            <button class="card-gallery-arrow card-gallery-arrow-next" type="button" data-network-gallery-next aria-label="Next image">›</button>
            <div class="card-gallery-dots" data-network-gallery-dots aria-hidden="true">
              <span class="card-gallery-dot active" data-network-image-dot></span>
              <span class="card-gallery-dot" data-network-image-dot></span>
              <span class="card-gallery-dot" data-network-image-dot></span>
            </div>
          </figure>
        </div>
        <div class="network-dialog-copy">
          <header>
            <h2 data-live-modal-name></h2>
            <p class="network-role" data-live-modal-role hidden></p>
            <div data-live-modal-intro hidden></div>
          </header>

          <section data-live-how-we-work-together hidden>
            <h3>How we work together</h3>
            <div class="rich-body" data-live-how-we-work-together-text></div>
          </section>

          <section data-live-partner-metrics hidden>
            <h3>Our work together</h3>
            <div class="network-partner-stats" data-live-partner-metrics-list></div>
            <template data-network-metric-template>
              <div><strong data-live-metric-value></strong><span data-live-metric-name></span></div>
            </template>
          </section>

          <section class="network-offerings" data-live-offerings hidden>
            <h3>What you can do here</h3>
            <div class="network-offering-list" data-live-offerings-list>
              <div class="network-offering-row" data-live-offering-row="Refills" hidden><span class="network-icon-badge"><Icon name="refill" /></span><div data-live-offering-text></div></div>
              <div class="network-offering-row" data-live-offering-row="Coffee" hidden><span class="network-icon-badge"><Icon name="cafe" /></span><div data-live-offering-text></div></div>
              <div class="network-offering-row" data-live-offering-row="Evening drinks" hidden><span class="network-icon-badge"><Icon name="bar" /></span><div data-live-offering-text></div></div>
              <div class="network-offering-row" data-live-offering-row="Workshops" hidden><span class="network-icon-badge"><Icon name="volunteering" /></span><div data-live-offering-text></div></div>
              <div class="network-offering-row" data-live-offering-row="Volunteering" hidden><span class="network-icon-badge"><Icon name="volunteering" /></span><div data-live-offering-text></div></div>
              <div class="network-offering-row" data-live-offering-row="Pick your Own" hidden><span class="network-icon-badge"><Icon name="apple" /></span><div data-live-offering-text></div></div>
              <div class="network-offering-row" data-live-offering-row="Kid's club" hidden><span class="network-icon-badge"><Icon name="volunteering" /></span><div data-live-offering-text></div></div>
              <div class="network-offering-row" data-live-offering-row="Bees" hidden><span class="network-icon-badge"><Icon name="bee" /></span><div data-live-offering-text></div></div>
              <div class="network-offering-row" data-live-offering-row="Food bank" hidden><span class="network-icon-badge"><Icon name="collection-point" /></span><div data-live-offering-text></div></div>
            </div>
          </section>

          <section class="network-collection-details" data-live-collection hidden>
            <h3>Collect from this partner</h3>
            <div class="network-collection-point-list" data-live-collection-points></div>
            <template data-network-collection-point-template>
              <div class="network-collection-point-row">
                <span class="network-detail-icon"><Icon name="collection-point" /></span>
                <div class="network-collection-point-copy">
                  <strong data-live-collection-point-name></strong>
                  <span data-live-collection-point-time></span>
                </div>
                <a class="text-link network-icon-link" data-live-collection-point-directions target="_blank" rel="noopener noreferrer"><Icon name="directions" /> <span>Directions →</span></a>
              </div>
            </template>
          </section>

          <section class="network-links" data-live-links hidden>
            <h3>Get involved</h3>
            <div>
              <a class="text-link" data-live-volunteer href="#" target="_blank" rel="noopener noreferrer" hidden>Volunteer →</a>
              <a class="text-link network-icon-link" data-live-website href="#" target="_blank" rel="noopener noreferrer" hidden><Icon name="website" /> <span>Website →</span></a>
              <a class="text-link network-icon-link" data-live-social href="#" target="_blank" rel="noopener noreferrer" hidden><Icon name="instagram" /> <span>Follow →</span></a>
              <a class="text-link network-icon-link" data-live-directions href="#" hidden><Icon name="directions" /> <span>Directions →</span></a>
            </div>
          </section>
        </div>
      </div>
    </dialog>
  </template>
</div>

<script>
  const initialiseNetworkGalleries = () => {
    document.querySelectorAll('[data-network-gallery]').forEach((gallery) => {
      if (gallery.dataset.galleryReady === 'true') return;
      gallery.dataset.galleryReady = 'true';
      const track = gallery.querySelector('[data-network-gallery-track]');
      const slides = [...gallery.querySelectorAll('[data-network-image-slot]')];
      const dots = [...gallery.querySelectorAll('[data-network-image-dot]')];
      const previous = gallery.querySelector('[data-network-gallery-prev]');
      const next = gallery.querySelector('[data-network-gallery-next]');
      if (!track || slides.length < 2) return;
      const activeIndex = () => {
        const width = track.clientWidth || 1;
        return Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / width)));
      };
      const updateDots = () => {
        const index = activeIndex();
        dots.forEach((dot, dotIndex) => dot.classList.toggle('active', dotIndex === index));
      };
      const move = (direction) => {
        const target = Math.max(0, Math.min(slides.length - 1, activeIndex() + direction));
        track.scrollTo({ left: target * (track.clientWidth || 1), behavior: 'smooth' });
      };
      previous?.addEventListener('click', () => move(-1));
      next?.addEventListener('click', () => move(1));
      track.addEventListener('scroll', () => window.requestAnimationFrame(updateDots), { passive: true });
      updateDots();
    });
  };

  const initNetworkDialogs = () => {
    document.querySelectorAll('[data-network-open]').forEach((button) => {
      if (button.dataset.ready === 'true') return;
      button.dataset.ready = 'true';
      const open = (event) => {
        if (event?.target?.closest?.('[data-network-gallery-prev],[data-network-gallery-next]')) return;
        const dialog = document.getElementById(button.getAttribute('data-network-open') || '');
        if (dialog && typeof dialog.showModal === 'function') dialog.showModal();
      };
      button.addEventListener('click', open);
      if (button.getAttribute('role') === 'button') button.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); open(event); }
      });
    });
    document.querySelectorAll('[data-network-dialog]').forEach((dialog) => {
      if (dialog.dataset.ready === 'true') return;
      dialog.dataset.ready = 'true';
      dialog.querySelector('[data-network-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    });
  };

  const openRequestedPartner = () => {
    const requested = new URLSearchParams(window.location.search).get('partner');
    if (!requested) return;
    const dialog = [...document.querySelectorAll('[data-network-dialog]')].find((item) => item.id.endsWith(`-${requested}`));
    if (dialog && !dialog.open && typeof dialog.showModal === 'function') dialog.showModal();
  };

  const initialiseNetwork = () => {
    initialiseNetworkGalleries();
    initNetworkDialogs();
    openRequestedPartner();
  };

  initialiseNetwork();
  document.addEventListener('rooted:network-rendered', initialiseNetwork);
  document.addEventListener('astro:page-load', initialiseNetwork);
</script>
