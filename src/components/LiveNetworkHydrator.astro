<script>
  const escapeHtml = (value = '') => String(value).replace(/[&<>'"]/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
  }[char]));

  const richText = (value = '') => {
    const safe = escapeHtml(value).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/\*([^*]+)\*/g, '<em>$1</em>');
    return safe.split(/\n\s*\n/).filter(Boolean).map((paragraph) => `<p>${paragraph.replace(/\n/g, '<br>')}</p>`).join('');
  };

  const safeId = (value) => String(value || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
  const setText = (root, selector, value) => {
    const el = root?.querySelector(selector);
    if (!el) return;
    el.textContent = value || '';
    el.hidden = !value;
  };
  const setLink = (root, selector, href, label) => {
    const el = root?.querySelector(selector);
    if (!el) return;
    el.hidden = !href;
    if (href) el.href = href;
    if (label) el.textContent = label;
  };

  const populateGallery = (container, partner, modalId, opensDialog = false) => {
    if (!container) return;
    const images = [
      { src: partner.image, alt: partner.imageAlt },
      { src: partner.image2, alt: partner.image2Alt },
      { src: partner.image3, alt: partner.image3Alt }
    ].filter((image) => image.src);
    container.hidden = images.length === 0;
    if (!images.length) return;

    if (opensDialog) {
      container.setAttribute('data-network-open', modalId);
      container.setAttribute('aria-label', `Learn more about ${partner.name || 'this partner'}`);
    }

    const gallery = container.querySelector('[data-network-gallery]');
    if (!gallery) return;
    const track = gallery.querySelector('[data-network-gallery-track]');
    if (track) track.setAttribute('aria-label', `${partner.name || 'Partner'} image gallery`);

    const slots = [...gallery.querySelectorAll('[data-network-image-slot]')];
    slots.forEach((slot, index) => {
      const image = images[index];
      if (!image) { slot.remove(); return; }
      const img = slot.querySelector('[data-live-network-image]');
      if (img) {
        img.src = image.src;
        img.alt = image.alt || '';
      }
    });

    const dots = [...gallery.querySelectorAll('[data-network-image-dot]')];
    dots.forEach((dot, index) => { if (!images[index]) dot.remove(); });
    const multiple = images.length > 1;
    const previous = gallery.querySelector('[data-network-gallery-prev]');
    const next = gallery.querySelector('[data-network-gallery-next]');
    const dotsWrap = gallery.querySelector('[data-network-gallery-dots]');
    if (previous) previous.hidden = !multiple;
    if (next) next.hidden = !multiple;
    if (dotsWrap) dotsWrap.hidden = !multiple;
  };

  const populateMetrics = (dialog, partner, metrics) => {
    const partnerMetrics = metrics.filter((metric) => metric.networkPartner === partner.name && (metric.placements || []).includes('Partner'));
    const section = dialog.querySelector('[data-live-partner-metrics]');
    const list = dialog.querySelector('[data-live-partner-metrics-list]');
    const template = dialog.querySelector('[data-network-metric-template]');
    if (!section || !list) return;
    section.hidden = !partnerMetrics.length;
    list.replaceChildren();
    if (!template) return;
    partnerMetrics.forEach((metric) => {
      const node = template.content.firstElementChild?.cloneNode(true);
      if (!node) return;
      const value = node.querySelector('[data-live-metric-value]');
      const name = node.querySelector('[data-live-metric-name]');
      if (value) value.textContent = metric.displayValue ?? metric.value ?? metric.valueText ?? '';
      if (name) name.textContent = metric.name || '';
      list.appendChild(node);
    });
  };

  const populateOfferings = (dialog, partner) => {
    const section = dialog.querySelector('[data-live-offerings]');
    const rows = [...dialog.querySelectorAll('[data-live-offering-row]')];
    let visible = 0;
    rows.forEach((row) => {
      const key = row.getAttribute('data-live-offering-row') || '';
      const value = String(partner.offeringText?.[key] || '').trim();
      row.hidden = !value;
      const text = row.querySelector('[data-live-offering-text]');
      if (text) text.textContent = value;
      if (value) visible += 1;
    });
    if (section) section.hidden = visible === 0;
  };

  const updatePartner = (card, dialog, partner, metrics, modalId) => {
    const role = (partner.role || []).join(' · ');
    const description = partner.longDescription || partner.summary || '';
    card.dataset.networkPartnerId = String(partner.id);
    dialog.dataset.networkPartnerId = String(partner.id);
    dialog.id = modalId;

    card.querySelectorAll('[data-live-card-media],[data-live-card-name],.network-explore').forEach((node) => node.setAttribute('data-network-open', modalId));
    const close = dialog.querySelector('[data-network-close]');
    if (close) close.setAttribute('aria-label', `Close ${partner.name || 'partner'}`);

    populateGallery(card.querySelector('[data-live-card-media]'), partner, modalId, true);
    populateGallery(dialog.querySelector('[data-live-modal-media]'), partner, modalId, false);

    setText(card, '[data-live-card-name]', partner.name);
    setText(card, '[data-live-card-role]', role);
    setText(card, '[data-live-card-summary]', partner.summary || '');
    setText(dialog, '[data-live-modal-name]', partner.name);
    setText(dialog, '[data-live-modal-role]', role);

    const intro = dialog.querySelector('[data-live-modal-intro]');
    if (intro) {
      intro.hidden = !description;
      intro.innerHTML = description ? `<div class="rich-body network-partner-intro">${richText(description)}</div>` : '';
    }

    populateMetrics(dialog, partner, metrics);
    populateOfferings(dialog, partner);

    const point = partner.collectionPoint || null;
    const collection = dialog.querySelector('[data-live-collection]');
    if (collection) {
      collection.hidden = !point;
      if (point) {
        const time = collection.querySelector('[data-live-collection-time]');
        const items = collection.querySelector('[data-live-collection-items]');
        if (time) time.textContent = (point.collectionSlots || []).map((slot) => `${slot.day} · ${slot.time}`).join('  ·  ') || point.collectionTime || '';
        if (items) items.textContent = (point.availableCategories || []).length ? point.availableCategories.join(', ') : 'Rooted Commons orders';
      }
    }

    const returnPath = `/our-network/?partner=${partner.id}`;
    const directionsHref = point ? `/collection-points/?focus=${encodeURIComponent(point.id)}&return=${encodeURIComponent(returnPath)}` : '';
    const links = dialog.querySelector('[data-live-links]');
    const hasLinks = partner.getInvolvedUrl || partner.volunteerUrl || partner.website || partner.socialUrl || directionsHref;
    if (links) links.hidden = !hasLinks;
    const getInvolved = dialog.querySelector('[data-live-get-involved]');
    if (getInvolved) {
      getInvolved.hidden = !partner.getInvolvedUrl;
      if (partner.getInvolvedUrl) getInvolved.href = partner.getInvolvedUrl;
      getInvolved.textContent = partner.getInvolvedLabel || 'Get involved';
    }
    setLink(dialog, '[data-live-volunteer]', partner.volunteerUrl, 'Volunteer →');
    setLink(dialog, '[data-live-website]', partner.website);
    setLink(dialog, '[data-live-social]', partner.socialUrl);
    setLink(dialog, '[data-live-directions]', directionsHref);
  };

  const renderNetworkGrid = (grid, partners, metrics) => {
    const template = grid.querySelector('template[data-network-partner-template]');
    if (!template) return;
    grid.querySelectorAll('[data-network-generated]').forEach((node) => node.remove());
    partners.forEach((partner) => {
      const fragment = template.content.cloneNode(true);
      const card = fragment.querySelector('.network-card');
      const dialog = fragment.querySelector('.network-dialog');
      if (!card || !dialog) return;
      const modalId = `network-partner-${safeId(partner.name)}-${partner.id}`;
      updatePartner(card, dialog, partner, metrics, modalId);
      grid.appendChild(fragment);
    });
  };

  let liveNetworkPromise;
  const fetchLiveNetwork = () => liveNetworkPromise ||= (window.RootedData?.publicNetwork?.() || fetch('/api/public-network', { headers: { accept: 'application/json' } })).then((response) => {
    if (!response.ok) throw new Error(`Public network request failed (${response.status})`);
    return response.json();
  });

  const hydrateLiveNetwork = async () => {
    const metricGrids = [...document.querySelectorAll('[data-live-metrics]')];
    const networkGrids = [...document.querySelectorAll('[data-live-network]')];
    if (!metricGrids.length && !networkGrids.length) return;
    try {
      const data = await fetchLiveNetwork();
      const metrics = data.metrics || [];
      const partners = data.partners || [];
      window.__rootedPublicNetwork = data;
      window.dispatchEvent(new CustomEvent('rooted:public-network', { detail: data }));
      const statSections = data.statSections || [];

      metricGrids.forEach((grid) => {
        const sectionId = Number(grid.dataset.sectionId);
        const sectionKey = String(grid.dataset.sectionKey || '').trim();
        const liveSection = statSections.find((section) => (Number.isFinite(sectionId) && section.id === sectionId) || (sectionKey && section.key === sectionKey));
        const ids = liveSection ? (liveSection.metricIds || []).map(Number).filter(Number.isFinite) : String(grid.dataset.metricIds || '').split(',').map(Number).filter(Number.isFinite);
        const names = liveSection ? (liveSection.metricNames || []).map((value) => String(value).trim()).filter(Boolean) : String(grid.dataset.metricNames || '').split('|').map((value) => value.trim()).filter(Boolean);
        const selected = metrics.filter((metric) => ids.includes(metric.id) || names.includes(metric.name));
        if (liveSection?.columns) grid.style.setProperty('--columns', String(liveSection.columns));
        if (!selected.length) return;
        grid.innerHTML = selected.map((metric) => `<article class="stat-tile align-center">${metric.icon ? `<img class="impact-stat-icon" src="${escapeHtml(metric.icon)}" alt="" aria-hidden="true">` : ''}<strong class="stat-number">${escapeHtml(metric.value)}</strong>${metric.description ? `<small class="stat-description">${escapeHtml(metric.description)}</small>` : ''}</article>`).join('');
      });

      networkGrids.forEach((grid) => renderNetworkGrid(grid, partners, metrics));
      document.dispatchEvent(new CustomEvent('rooted:network-rendered'));
    } catch (error) {
      console.error('Unable to load live Metrics / Network Partners', error);
    }
  };

  hydrateLiveNetwork();
  document.addEventListener('astro:page-load', hydrateLiveNetwork);
</script>
