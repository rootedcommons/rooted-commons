<script>
  const escapeHtml = (value = '') => String(value).replace(/[&<>'"]/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
  }[char]));

  const richText = (value = '') => {
    const safe = escapeHtml(value)
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/\*([^*]+)\*/g, '<em>$1</em>');
    return safe.split(/\n\s*\n/).filter(Boolean).map((paragraph) => `<p>${paragraph.replace(/\n/g, '<br>')}</p>`).join('');
  };


  const iconHtml = (name, className = 'rc-icon') => {
    const paths = {
      calendar: '<path d="M7 2v3M17 2v3"/><path d="M4.5 8.5h15"/><path d="M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><circle cx="9" cy="14" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="14" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="14" r="1" fill="currentColor" stroke="none"/>',
      refill: '<path d="M9 3h6M12 3v3M10 6h4"/><path d="M9 7.5h6l1 3v8.5a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-8.5l1-3Z"/><path d="M10.5 13h3M12 11.5v3"/>',
      'collection-point': '<path d="m4.5 7.5 7.5-4 7.5 4-7.5 4-7.5-4Z"/><path d="M4.5 7.5V16.5L12 20.5l7.5-4V7.5M12 11.5v9"/><path d="M8.5 5.4 16 9.4"/>',
      grower: '<path d="M12 21V10"/><path d="M12 14c-4.5 0-7-2.4-7-6.5 4.7 0 7 2.2 7 6.5Z"/><path d="M12 10c0-4.5 2.3-7 6.8-7 0 4.8-2.3 7-6.8 7Z"/><path d="M8 21h8"/>',
      shop: '<path d="M5 9v10h14V9"/><path d="M3.5 9 5 4h14l1.5 5"/><path d="M3.5 9c0 1.4 1 2.5 2.3 2.5S8 10.4 8 9c0 1.4 1 2.5 2.3 2.5S12.5 10.4 12.5 9c0 1.4 1 2.5 2.3 2.5S17 10.4 17 9c0 1.4 1 2.5 2.3 2.5S21 10.4 21 9"/><path d="M9 19v-5h6v5"/>',
      cafe: '<path d="M5 8h11v6a5 5 0 0 1-5 5h-1a5 5 0 0 1-5-5V8Z"/><path d="M16 10h1.5a2.5 2.5 0 0 1 0 5H16"/><path d="M8 4c0 1 1 1.2 1 2M12 4c0 1 1 1.2 1 2"/><path d="M4 21h15"/>',
      volunteering: '<path d="M12 19.5 5.7 13.4a3.9 3.9 0 0 1 5.5-5.5l.8.8.8-.8a3.9 3.9 0 0 1 5.5 5.5L12 19.5Z"/><path d="M3 18.5c2.5.2 4.3.8 6 2.5M21 18.5c-2.5.2-4.3.8-6 2.5"/>',
      website: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.6 2.4 4 5.4 4 9s-1.4 6.6-4 9"/><path d="M12 3c-2.6 2.4-4 5.4-4 9s1.4 6.6 4 9"/><path d="M5.2 6.7c2 .9 4.3 1.3 6.8 1.3s4.8-.4 6.8-1.3"/><path d="M5.2 17.3c2-.9 4.3-1.3 6.8-1.3s4.8.4 6.8 1.3"/>',
      instagram: '<rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.5"/><circle cx="17.2" cy="6.8" r=".8" fill="currentColor" stroke="none"/>',
      directions: '<path d="M12 21s6-5.6 6-11a6 6 0 1 0-12 0c0 5.4 6 11 6 11Z"/><circle cx="12" cy="10" r="2.2"/>',
      bar: '<path d="M7 4h10l-1 5.5a4.1 4.1 0 0 1-4 3.5 4.1 4.1 0 0 1-4-3.5L7 4Z"/><path d="M12 13v6"/><path d="M9 21h6"/>',
      bee: '<ellipse cx="12" cy="13" rx="3.2" ry="5"/><path d="M9.2 11.2h5.6M9 14h6M9.6 16.7h4.8"/><path d="M10 8.8C8.5 6.2 6 5.8 4.8 7.5c-.8 1.2.1 3.1 3 3.5"/><path d="M14 8.8c1.5-2.6 4-3 5.2-1.3.8 1.2-.1 3.1-3 3.5"/><path d="M10.5 7.5 9.7 5.8M13.5 7.5l.8-1.7"/><circle cx="12" cy="7.8" r="1.8"/><path d="M12 18v2"/>'
    };
    if (!paths[name]) return '';
    return `<svg class="${escapeHtml(className)}" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths[name]}</svg>`;
  };

  const offeringIcons = {
    'Refills':'refill',
    'Coffee':'cafe',
    'Evening drinks':'bar',
    'Workshops':'volunteering',
    'Volunteering':'volunteering',
    'Fruit':'grower',
    "Kid's club":'volunteering',
    'Bees':'bee',
    'Food bank':'collection-point'
  };

  const galleryHtml = (partner, prefix) => {
    const images = [
      [partner.image, partner.imageAlt],
      [partner.image2, partner.image2Alt],
      [partner.image3, partner.image3Alt]
    ].filter(([src]) => src);
    if (!images.length) return '';
    if (images.length === 1) return `<figure class="card-media image-size-large fit-cover"><img src="${escapeHtml(images[0][0])}" alt="${escapeHtml(images[0][1] || '')}" loading="lazy"></figure>`;
    return `<figure class="card-gallery-shell" data-card-gallery id="${prefix}">
      <div class="card-gallery image-size-large fit-cover" data-card-gallery-track tabindex="0" aria-label="Image gallery">
        ${images.map(([src, alt]) => `<div class="card-gallery-slide" data-card-gallery-slide><img src="${escapeHtml(src)}" alt="${escapeHtml(alt || '')}" loading="lazy"></div>`).join('')}
      </div>
      <button class="card-gallery-arrow card-gallery-arrow-prev" type="button" data-card-gallery-prev aria-label="Previous image">‹</button>
      <button class="card-gallery-arrow card-gallery-arrow-next" type="button" data-card-gallery-next aria-label="Next image">›</button>
      <div class="card-gallery-dots" aria-hidden="true">${images.map((_, index) => `<span class="card-gallery-dot${index === 0 ? ' active' : ''}" data-card-gallery-dot></span>`).join('')}</div>
    </figure>`;
  };

  const initGalleries = () => {
    document.querySelectorAll('[data-card-gallery]').forEach((gallery) => {
      if (gallery.dataset.galleryReady === 'true') return;
      gallery.dataset.galleryReady = 'true';
      const track = gallery.querySelector('[data-card-gallery-track]');
      const slides = [...gallery.querySelectorAll('[data-card-gallery-slide]')];
      const dots = [...gallery.querySelectorAll('[data-card-gallery-dot]')];
      if (!track || slides.length < 2) return;
      const activeIndex = () => Math.max(0, Math.min(slides.length - 1, Math.round(track.scrollLeft / (track.clientWidth || 1))));
      const updateDots = () => dots.forEach((dot, index) => dot.classList.toggle('active', index === activeIndex()));
      const move = (direction) => slides[Math.max(0, Math.min(slides.length - 1, activeIndex() + direction))]?.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'start' });
      gallery.querySelector('[data-card-gallery-prev]')?.addEventListener('click', () => move(-1));
      gallery.querySelector('[data-card-gallery-next]')?.addEventListener('click', () => move(1));
      track.addEventListener('scroll', () => requestAnimationFrame(updateDots), { passive: true });
      updateDots();
    });
  };

  const initDialogs = () => {
    document.querySelectorAll('[data-network-open]').forEach((button) => {
      if (button.dataset.ready === 'true') return;
      button.dataset.ready = 'true';
      button.addEventListener('click', () => document.getElementById(button.getAttribute('data-network-open') || '')?.showModal?.());
    });
    document.querySelectorAll('[data-network-dialog]').forEach((dialog) => {
      if (dialog.dataset.ready === 'true') return;
      dialog.dataset.ready = 'true';
      dialog.querySelector('[data-network-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    });
  };

  const openRequestedPartner = () => {
    const requested = new URLSearchParams(window.location.search).get('partner');
    if (!requested) return;
    const dialog = [...document.querySelectorAll('[data-network-dialog]')].find((item) => item.id.endsWith(`-${requested}`));
    if (dialog && !dialog.open) dialog.showModal?.();
  };

  const partnerHtml = (partner, metrics) => {
    const safeKey = `${String(partner.name || '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}-${partner.id}`;
    const modalId = `network-partner-${safeKey}`;
    const partnerMetrics = metrics.filter((metric) => metric.networkPartner === partner.name && (metric.placements || []).includes('Partner'));
    const role = (partner.role || []).join(' · ');
    const description = partner.longDescription || partner.summary || '';
    const metricHtml = partnerMetrics.length ? `<section><h3>Our work together</h3><div class="network-partner-stats">${partnerMetrics.map((metric) => `<div><strong>${escapeHtml(metric.value)}</strong><span>${escapeHtml(metric.name)}</span></div>`).join('')}</div></section>` : '';
    const offeringRows = Object.entries(partner.offeringText || {})
      .filter(([, value]) => String(value || '').trim())
      .map(([offering, value]) => {
        const icon = offeringIcons[offering] || '';
        const text = String(value).trim();
        return `<div class="network-offering-row${icon ? '' : ' network-offering-row-no-icon'}">${icon ? `<span class="network-icon-badge">${iconHtml(icon)}</span>` : ''}<span>${escapeHtml(text)}</span></div>`;
      }).join('');
    const point = partner.collectionPoint || null;
    const returnPath = `/our-network/?partner=${partner.id}`;
    const directionsHref = point ? `/collection-points/?focus=${encodeURIComponent(point.id)}&return=${encodeURIComponent(returnPath)}` : '';
    const collectionHtml = point ? `<section class="network-collection-details"><h3>Collection details</h3><div class="network-detail-row"><span class="network-detail-icon">${iconHtml('calendar')}</span><span>${escapeHtml((point.collectionSlots || []).map((slot) => `${slot.day} · ${slot.time}`).join('  ·  ') || point.collectionTime || '')}</span></div><div class="network-detail-row"><span class="network-detail-icon">${iconHtml('collection-point')}</span><span>${escapeHtml((point.availableCategories || []).length ? point.availableCategories.join(', ') : 'Rooted Commons orders')}</span></div></section>` : '';
    const links = [
      partner.getInvolvedUrl ? `<a class="button button-medium" href="${escapeHtml(partner.getInvolvedUrl)}">${escapeHtml(partner.getInvolvedLabel || 'Get involved')}</a>` : '',
      partner.volunteerUrl ? `<a class="text-link" href="${escapeHtml(partner.volunteerUrl)}">Volunteer →</a>` : '',
      partner.website ? `<a class="text-link network-icon-link" href="${escapeHtml(partner.website)}">${iconHtml('website')}<span>Website →</span></a>` : '',
      partner.socialUrl ? `<a class="text-link network-icon-link" href="${escapeHtml(partner.socialUrl)}">${iconHtml('instagram')}<span>Follow →</span></a>` : '',
      directionsHref ? `<a class="text-link network-icon-link" href="${escapeHtml(directionsHref)}">${iconHtml('directions')}<span>Directions →</span></a>` : ''
    ].filter(Boolean).join('');
    return `<article class="network-card">
      ${galleryHtml(partner, `network-card-gallery-${safeKey}`)}
      <div class="network-card-copy"><h3>${escapeHtml(partner.name)}</h3>${role ? `<p class="network-role">${escapeHtml(role)}</p>` : ''}${partner.summary ? `<p>${escapeHtml(partner.summary)}</p>` : ''}<button class="network-explore" type="button" data-network-open="${modalId}">Explore <span aria-hidden="true">→</span></button></div>
    </article>
    <dialog class="network-dialog" id="${modalId}" data-network-dialog>
      <button class="network-dialog-close" type="button" data-network-close aria-label="Close ${escapeHtml(partner.name)}">×</button>
      <div class="network-dialog-inner">
        <div class="network-dialog-media">${galleryHtml(partner, `network-dialog-gallery-${safeKey}`)}</div>
        <div class="network-dialog-copy">
          <header><h2>${escapeHtml(partner.name)}</h2>${role ? `<p class="network-role">${escapeHtml(role)}</p>` : ''}${description ? `<div class="rich-body network-partner-intro">${richText(description)}</div>` : ''}</header>
          ${metricHtml}
          ${offeringRows ? `<section class="network-offerings"><h3>What you can do here</h3><div class="network-offering-list">${offeringRows}</div></section>` : ''}
          ${collectionHtml}
          ${links ? `<section class="network-links"><h3>Get involved</h3><div>${links}</div></section>` : ''}
        </div>
      </div>
    </dialog>`;
  };

  let liveNetworkPromise;
  const fetchLiveNetwork = () => liveNetworkPromise ||= (window.RootedData?.publicNetwork?.() || fetch('/api/public-network', { headers: { accept: 'application/json' } }))
    .then((response) => { if (!response.ok) throw new Error(`Public network request failed (${response.status})`); return response.json(); });

  const hydrateLiveNetwork = async () => {
    const metricGrids = [...document.querySelectorAll('[data-live-metrics]')];
    const networkGrids = [...document.querySelectorAll('[data-live-network]')];
    if (!metricGrids.length && !networkGrids.length) return;
    try {
      const data = await fetchLiveNetwork();
      const metrics = data.metrics || [];
      const partners = data.partners || [];
      window.__rootedPublicNetwork = data;
      window.dispatchEvent(new CustomEvent('rooted:public-network', { detail: data }));

      const statSections = data.statSections || [];
      metricGrids.forEach((grid) => {
        const sectionId = Number(grid.dataset.sectionId);
        const sectionKey = String(grid.dataset.sectionKey || '').trim();
        const liveSection = statSections.find((section) =>
          (Number.isFinite(sectionId) && section.id === sectionId) ||
          (sectionKey && section.key === sectionKey)
        );
        const ids = liveSection
          ? (liveSection.metricIds || []).map(Number).filter(Number.isFinite)
          : String(grid.dataset.metricIds || '').split(',').map(Number).filter(Number.isFinite);
        const names = liveSection
          ? (liveSection.metricNames || []).map((value) => String(value).trim()).filter(Boolean)
          : String(grid.dataset.metricNames || '').split('|').map((value) => value.trim()).filter(Boolean);
        const selected = metrics.filter((metric) => ids.includes(metric.id) || names.includes(metric.name));
        if (liveSection?.columns) grid.style.setProperty('--columns', String(liveSection.columns));
        if (!selected.length) return;
        grid.innerHTML = selected.map((metric) => `<article class="stat-tile align-center">${metric.icon ? `<img class="impact-stat-icon" src="${escapeHtml(metric.icon)}" alt="" aria-hidden="true">` : ''}<strong class="stat-number">${escapeHtml(metric.value)}</strong>${metric.description ? `<small class="stat-description">${escapeHtml(metric.description)}</small>` : ''}</article>`).join('');
      });

      networkGrids.forEach((grid) => { grid.innerHTML = partners.map((partner) => partnerHtml(partner, metrics)).join(''); });
      initGalleries();
      initDialogs();
      openRequestedPartner();
    } catch (error) {
      console.error('Unable to load live Metrics / Network Partners', error);
    }
  };

  hydrateLiveNetwork();
  document.addEventListener('astro:page-load', hydrateLiveNetwork);
</script>
