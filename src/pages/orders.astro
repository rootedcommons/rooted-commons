---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductGrid from '../components/ProductGrid.astro';
import SectionRenderer from '../components/SectionRenderer.astro';
import { getSiteData } from '../lib/baserow';
import { buildSectionBlocks } from '../lib/sections';

const data = await getSiteData();
const page = data.pages.find((item) => item.slug === 'orders') || {
  title: 'Weekly Shop', intro: '', titleSize: 'large', introSize: 'medium', heroLayout: 'text-only'
};
const orderSections = data.sections.filter((section) => section.page === 'orders');
const gridSection = orderSections.find((section) => String(section.type).toLowerCase() === 'grid');
const sharedSections = orderSections.filter((section) => section !== gridSection && !section.catalogueCategory);
const sharedBlocks = buildSectionBlocks(sharedSections);
const broadCategories = [...new Set(data.products.map((product) => product.category || product.categories?.[0]).filter(Boolean))];
const preferredOrder = ['Cupboard Staples', 'Fresh Produce', 'Refills'];
broadCategories.sort((a, b) => {
  const ai = preferredOrder.indexOf(a); const bi = preferredOrder.indexOf(b);
  if (ai >= 0 || bi >= 0) return (ai < 0 ? 999 : ai) - (bi < 0 ? 999 : bi);
  return a.localeCompare(b);
});
const categoryBlocks = Object.fromEntries(broadCategories.map((category) => [
  category,
  buildSectionBlocks(orderSections.filter((section) => section !== gridSection && section.catalogueCategory === category))
]));
const columns = gridSection?.columns || 3;
const s = data.settings;
const c = (key, fallback = '') => data.interfaceContent[key] || fallback;
const collectionPointsForMemberBar = data.collectionPoints.map((point) => ({ id: point.id, name: point.name, collectionSlots: point.collectionSlots || [] }));
const shopConfigJson = JSON.stringify({ basketEmptyText: c('basket.empty'), basketNotice: c('basket.notice'), broadCategories, collectionPointsForMemberBar }).replace(/</g, '\\u003c');
---
<BaseLayout settings={s} pages={data.pages} title={page.seoTitle || page.title} description={page.seoDescription || page.intro}>
  <div class="shop-basket-bar" aria-label="Basket shortcut">
    <button id="floating-basket" class="floating-basket" type="button" aria-controls="basket-drawer" aria-expanded="false">
      <span>{c('basket.floating_label')}</span><strong><span data-basket-count>0</span> · <span data-basket-total>£0.00</span></strong>
    </button>
  </div>

  <section class="orders-category-shell">
    <nav class="shop-category-nav" aria-label="Shop categories">
      {broadCategories.map((category, index) => (
        <button class={`shop-category-tab ${index === 0 ? 'active' : ''}`} type="button" data-shop-category={category}>
          {category}
        </button>
      ))}
    </nav>

    {broadCategories.map((category, index) => (
      <div class={`catalogue-panel ${(categoryBlocks[category] || []).length ? 'has-intro' : 'no-intro'}`} data-catalogue-panel={category} hidden={index !== 0}>
        {(categoryBlocks[category] || []).map((block) => <SectionRenderer block={block} products={data.products} settings={s} />)}
      </div>
    ))}
  </section>

  <section data-shop-shell class={`shop-shell background-${gridSection?.backgroundStyle || 'default'} space-above-${gridSection?.spaceAbove || 'small'} space-below-${gridSection?.spaceBelow || 'large'}`}>
    <div id="market-rollover-notice" class="market-rollover-notice" hidden></div>
    <section id="member-summary" class="member-summary" hidden aria-label="Member summary">
      <div class="member-summary-main">
        <p class="member-summary-greeting" id="member-summary-greeting"></p>
        <dl class="member-summary-facts">
          <div><dt>Available credit</dt><dd id="member-summary-credit"></dd></div>
          <div><dt>Collection</dt><dd id="member-summary-point"></dd></div>
          <div><dt>Orders close</dt><dd>Wednesday 18.00</dd></div>
        </dl>
      </div>
      <button id="member-summary-change" class="button button-secondary member-summary-change" type="button">Change collection preferences</button>
      <form id="member-summary-form" class="member-summary-form" hidden>
        <label for="member-summary-select">Collection point</label>
        <select id="member-summary-select" required></select>
        <label for="member-summary-day">Preferred day</label>
        <select id="member-summary-day" required></select>
        <button class="button" type="submit">Save</button>
        <button id="member-summary-cancel" class="text-button" type="button">Cancel</button>
        <span id="member-summary-message" class="small-print" aria-live="polite"></span>
      </form>
    </section>
    <div class="shop-toolbar">
      <div class="shop-controls">
        <input id="product-search" type="search" placeholder="Search all products…" aria-label="Search all products" />
        <label class="filter-control">Filter
          <select id="product-filter" aria-label="Filter products by subcategory"><option value="all">All</option></select>
        </label>
        <label class="sort-control">Sort by
          <select id="product-sort">
            <option value="popularity">Popularity</option>
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="name">A–Z</option>
            <option value="country">Country</option>
          </select>
        </label>
      </div>
    </div>
    <div class="shop-layout">
      <div id="product-availability-status" class="small-print" role="status">Checking current availability…</div>
      <div id="shop-products" aria-busy="true" hidden><ProductGrid products={data.products} columns={columns} showControls={true} settings={s} content={data.interfaceContent} /></div>
    </div>
  </section>

  <div data-orders-shared-sections>
    {sharedBlocks.map((block) => <SectionRenderer block={block} products={data.products} settings={s} />)}
  </div>
  <div id="basket-backdrop" class="basket-backdrop" hidden></div>
  <aside id="basket-drawer" class="basket-drawer" aria-hidden="true" aria-live="polite">
    <div class="basket-drawer-header"><h2>{c('basket.heading')}</h2><button id="close-basket" type="button" aria-label="Close basket">×</button></div>
    <div data-basket-lines><p>{c('basket.empty')}</p></div>
    <div class="basket-total"><span>{c('basket.total_label')}</span><strong data-basket-total>£0.00</strong></div>
    <p data-credit-line class="small-print">{c('basket.notice')}</p>
    <a data-checkout-link class="button" href="/checkout/">{c('basket.checkout_button')}</a>
  </aside>

  <script id="shop-config" type="application/json" set:html={shopConfigJson}></script>
  <script type="module" src="/scripts/shop.js?v=2.9.99"></script>
</BaseLayout>
