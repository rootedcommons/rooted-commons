---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData } from '../lib/baserow';

const data=await getSiteData();
const s=data.settings;
const contactEmail=s.contactEmail || 'info@rootedcommons.uk';
---
<BaseLayout settings={s} pages={data.pages} title="Contact" description="Contact Rooted Commons and find legal information about Roots to Fruits CIC.">
  <Fragment slot="head"><meta name="robots" content="noindex,follow" /></Fragment>
  <main class="legal-page">
    <article class="legal-content">
      <p class="eyebrow">Rooted Commons</p>
      <h1>Contact</h1>

      <h2>Get in touch</h2>
      <p>Email us at <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.</p>

      <h2>Legal information</h2>
      <p>Rooted Commons is a pilot project operated by Roots to Fruits CIC, registered in England and Wales.</p>
      <p><strong>Company number:</strong> 14699477</p>
      <p><strong>Registered office:</strong><br />
        95 St. Michael's Road<br />
        Aldershot<br />
        GU12 4JJ
      </p>
    </article>
  </main>
</BaseLayout>
