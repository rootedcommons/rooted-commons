---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSiteData } from '../lib/baserow';
const data=await getSiteData();
const s=data.settings;
const c=(key,fallback='')=>data.interfaceContent[key]||fallback;
const copy={
  title:c('account.title','Manage your membership'),
  intro:'',
  detailsHeading:c('account.details_heading','Update your details'),
  firstName:c('account.first_name','First name'),lastName:c('account.last_name','Last name'),email:c('account.email','Email address'),confirmEmail:c('account.confirm_email','Confirm email address'),phone:c('account.phone','Phone number'),
  save:c('account.save','Save changes'),saving:c('account.saving','Saving…'),
  emailHelp:c('account.email_help','If you change your email address, we’ll send a confirmation link to the new address before changing the email on your membership.'),
  emailsHeading:c('account.emails_heading','Your emails'),
  newsletter:c('account.newsletter','Include occasional Rooted Commons news and updates in my weekly market email.'),
  closeToggle:c('account.close_toggle','Close my account'),
  creditHeading:c('account.credit_heading','You still have {credit} of Member Credit'),
  creditIntro:c('account.credit_intro','Your Member Credit must be resolved before your membership can close.'),
  spendHeading:c('account.spend_heading','Spend down your Member Credit'),
  spendBody:c('account.spend_body','Recommended. Stop future regular commitment expectations, cancel the standing order with your bank, and keep using the weekly market until your Member Credit reaches £0. You can then return here to close your membership.'),
  stopCommitment:c('account.stop_commitment','Stop my regular commitment'),
  commitmentStopped:c('account.commitment_stopped','Your regular commitment is stopped. No further regular payments are expected while you use your remaining Member Credit. Remember to cancel the standing order with your bank.'),
  donateHeading:c('account.donate_heading','Donate your remaining Member Credit'),
  donateBody:c('account.donate_body','You can donate your full remaining balance and close your membership immediately. Choose Rooted Commons or an organisation in our network.'),
  donateRecipient:c('account.donate_recipient','Donate to'),
  donateButton:c('account.donate_button','Donate {credit} and close my membership'),
  contactHeading:c('account.contact_heading','Need to resolve it another way?'),
  contactBody:c('account.contact_body','Contact us and we’ll work out an appropriate way to resolve your remaining Member Credit.'),
  contactButton:c('account.contact_button','Contact us'),
  negativeCredit:c('account.negative_credit','Your Member Credit balance is {credit}. Please resolve this balance before closing your membership.'),
  closeButton:c('account.close_button','Close my membership'),
  closeConfirmHeading:c('account.close_confirm_heading','Close your membership?'),
  closeConfirmBody:c('account.close_confirm_body','This will close your Rooted Commons membership and sign you out on all devices. You will still need to cancel your standing order with your bank. Order and accounting records are retained where required.'),
  donateConfirmHeading:c('account.donate_confirm_heading','Donate your remaining Member Credit and close?'),
  donateConfirmBody:c('account.donate_confirm_body','You are choosing to donate {credit} of Member Credit to {recipient}. This will reduce your Member Credit to £0, close your Rooted Commons membership and sign you out on all devices. This donation cannot be undone through your member account.'),
  keep:c('account.keep','Keep my membership'),confirmClose:c('account.confirm_close','Close my membership'),confirmDonate:c('account.confirm_donate','Donate and close'),back:c('account.back','Back to dashboard')
};
const config=JSON.stringify({copy}).replace(/</g,'\\u003c');
---
<BaseLayout settings={s} pages={data.pages} title={copy.title} description={copy.intro}>
  <main class="account-shell">
    <a class="text-link account-back" href="/dashboard/">← {copy.back}</a>
    <section id="account-loading" class="dashboard-card"><p>Loading your membership…</p></section>
    <div id="account-content" hidden>
      <header class="account-header"><h1>{copy.title}</h1></header>
      <section class="dashboard-card account-card">
        <h2>{copy.detailsHeading}</h2>
        <form id="account-details-form" class="account-form">
          <label><span>{copy.firstName}</span><input id="account-first-name" name="firstName" autocomplete="given-name" required /></label>
          <label><span>{copy.lastName}</span><input id="account-last-name" name="lastName" autocomplete="family-name" required /></label>
          <label class="full"><span>{copy.email}</span><input id="account-email" name="email" type="email" autocomplete="email" required /></label>
          <label class="full"><span>{copy.confirmEmail}</span><input id="account-confirm-email" name="confirmEmail" type="email" autocomplete="email" required /></label>
          <p class="small-print full account-email-help">{copy.emailHelp}</p>
          <label class="full"><span>{copy.phone}</span><input id="account-phone" name="phone" type="tel" autocomplete="tel" required /></label>
          <div class="full account-email-preferences">
            <h3>{copy.emailsHeading}</h3>
            <label class="signup-check"><input id="account-newsletter" name="weeklyNewsletter" type="checkbox" /><span>{copy.newsletter}</span></label>
          </div>
          <div class="full account-actions"><button id="account-save" class="button" type="submit">{copy.save}</button><button id="account-close-toggle" class="button account-close-toggle" type="button" aria-expanded="false" aria-controls="account-close-panel">{copy.closeToggle}</button></div>
          <p id="account-message" class="small-print full" aria-live="polite"></p>
        </form>
      </section>

      <div class="account-close-area">
        <section id="account-close-panel" class="dashboard-card account-card account-close-card" hidden>
        <div id="account-positive-credit" class="account-resolution" hidden>
          <div class="highlight-box account-credit-highlight">
            <h3 id="account-credit-heading"></h3>
            <p>{copy.creditIntro}</p>
          </div>
          <div class="account-resolution-option">
            <h3>{copy.spendHeading}</h3><p>{copy.spendBody}</p>
            <button id="account-stop-commitment" class="button button-secondary" type="button">{copy.stopCommitment}</button>
            <p id="account-stopped-message" class="small-print" hidden>{copy.commitmentStopped}</p>
          </div>
          <div class="account-resolution-option">
            <h3>{copy.donateHeading}</h3><p>{copy.donateBody}</p>
            <label class="account-donation-select"><span>{copy.donateRecipient}</span><select id="account-donation-recipient"><option value="rooted-commons">Rooted Commons</option></select></label>
            <button id="account-donate-open" class="button" type="button"></button>
          </div>
          <div class="account-resolution-option account-contact-option">
            <h3>{copy.contactHeading}</h3><p>{copy.contactBody}</p><a class="button button-secondary" href="/contact/">{copy.contactButton}</a>
          </div>
        </div>
        <div id="account-negative-credit" class="account-resolution" hidden><p id="account-negative-credit-copy"></p><a class="button button-secondary" href="/contact/">{copy.contactButton}</a></div>
        <div id="account-zero-credit" hidden>
          <p id="account-close-context" class="small-print"></p>
          <button id="account-close-open" class="button button-secondary" type="button">{copy.closeButton}</button>
        </div>
        <p id="account-resolution-message" class="small-print" aria-live="polite"></p>
        </section>
      </div>
    </div>

    <dialog id="account-close-dialog" class="dashboard-confirm-dialog">
      <div class="dashboard-confirm-dialog-inner"><h3 id="account-close-dialog-heading">{copy.closeConfirmHeading}</h3><p id="account-close-confirm-body">{copy.closeConfirmBody}</p><div class="dashboard-point-actions"><button id="account-close-keep" class="button button-secondary" type="button">{copy.keep}</button><button id="account-close-confirm" class="button" type="button">{copy.confirmClose}</button></div><p id="account-close-message" class="small-print" aria-live="polite"></p></div>
    </dialog>
  </main>
  <script id="account-config" type="application/json" set:html={config}></script>
  <script type="module" src="/scripts/account.js?v=2.9.88"></script>
</BaseLayout>
