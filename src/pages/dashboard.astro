---
import FormattedText from '../components/FormattedText.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionRenderer from '../components/SectionRenderer.astro';
import { getSiteData } from '../lib/baserow';
import { buildSectionBlocks } from '../lib/sections';

const data=await getSiteData();
const page=data.pages.find((item)=>item.slug==='dashboard') || {title:'Your Rooted Commons',intro:'Your weekly market, membership and local food network in one place.',titleSize:'large',introSize:'medium',heroLayout:'none'};
const blocks=buildSectionBlocks(data.sections.filter((section)=>section.page==='dashboard'));
const s=data.settings;
const c=(key, fallback='')=>data.interfaceContent[key] || fallback;
const badgeLogos={
  'Founder 10':s.founder10Badge,
  'Founder 25':s.founder25Badge,
  'Founder 50':s.founder50Badge
};
const memberBadge=s.memberBadge;
const membershipPerks=s.membershipPerks || [];
const copy={
  greeting:c('dashboard.greeting','Hi {name}'),
  welcome:c('dashboard.welcome','Welcome {name}'),
  membershipEyebrow:c('dashboard.membership_eyebrow','Your membership'),
  defaultMemberLevel:c('dashboard.default_member_level','Rooted Commons member'),
  creditLabel:c('dashboard.credit_label','Member credit'),
  weeksSupporting:c('dashboard.weeks_supporting','supporting local producers'),
  consecutiveWeeks:c('dashboard.consecutive_weeks','consecutive weeks'),
  pauseIntroHeading:c('dashboard.pause_intro_heading','Taking a break?'),
  pauseIntroBody:c('dashboard.pause_intro_body','Pause your regular commitment for up to **8 weeks per calendar year** without losing your [consecutive-weeks streak](/faqs/#member-streaks).'),
  pauseButton:c('dashboard.pause_button','Pause your membership'),
  pauseFrom:c('dashboard.pause_from','Pause from'),
  pauseUntil:c('dashboard.pause_until','Pause until'),
  pauseAllowance:c('dashboard.pause_allowance','You have {weeks} of 8 pause weeks remaining this calendar year.'),
  pauseConfirm:c('dashboard.pause_confirm','Confirm pause'),
  pauseSaving:c('dashboard.pause_saving','Saving your pause…'),
  pauseFailed:c('dashboard.pause_failed','Your membership pause could not be saved.'),
  pauseActiveHeading:c('dashboard.pause_active_heading','Membership paused until {date}'),
  pauseActiveBody:c('dashboard.pause_active_body','Your streak is frozen at **{weeks} consecutive weeks**. You have **{remaining} of 8 pause weeks remaining** this calendar year. Your existing member perks remain available and you can still place orders while paused.'),
  pauseScheduledHeading:c('dashboard.pause_scheduled_heading','Membership pause scheduled'),
  pauseScheduledBody:c('dashboard.pause_scheduled_body','Your membership will pause from **{start}** until **{end}**. Your streak will be frozen during that period, routine weekly-market emails and regular-payment reminders will stop, and your existing perks will remain available.'),
  pauseCancelScheduled:c('dashboard.pause_cancel_scheduled','Cancel scheduled pause'),
  pauseEndEarly:c('dashboard.pause_end_early','End pause early'),
  pauseEndConfirm:c('dashboard.pause_end_confirm','End pause'),
  pauseCancel:c('dashboard.pause_cancel','Cancel'),
  localImpact:c('dashboard.local_impact','redirected locally'),
  topupNeeded:c('dashboard.topup_needed','{amount} top-up needed'),
  topupRequirement:c('dashboard.topup_requirement','Your balance must be back to £0.00 or above before collection.'),
  payBank:c('dashboard.pay_bank','Pay by bank transfer'),
  recommended:c('dashboard.recommended','Recommended'),
  payCard:c('dashboard.pay_card','Pay securely by card'),
  payOpenBanking:c('dashboard.pay_open_banking','Pay securely from your bank (Open Banking)'),
  cardComingSoon:c('dashboard.card_coming_soon','Card payments will be available here soon.'),
  openBankingComingSoon:c('dashboard.open_banking_coming_soon','Open Banking payments will be available here soon.'),
  bankAccountName:c('dashboard.bank_account_name','Account name'),
  bankSortCode:c('dashboard.bank_sort_code','Sort code'),
  bankAccountNumber:c('dashboard.bank_account_number','Account number'),
  bankReference:c('dashboard.bank_reference','Reference'),
  browseMarket:c('dashboard.shop_button','Browse this week’s market'),

  perksUnlocked:c('dashboard.perks_unlocked','You’ve unlocked…'),
  perksUpcoming:c('dashboard.perks_upcoming','Coming up…'),
  perkInWeeks:c('dashboard.perk_in_weeks','in {weeks} consecutive week{plural}'),
  collectionEyebrow:c('dashboard.collection_eyebrow','Your collection point'),
  collectionNotSelected:c('dashboard.collection_not_selected','Not selected'),
  changeCollection:c('dashboard.change_collection','Change collection preferences'),
  chooseCollection:c('dashboard.choose_collection','Choose your collection point'),
  collectionMapLink:c('dashboard.collection_map_link','see our map'),
  preferredCollectionDay:c('dashboard.preferred_collection_day','and collection day'),
  saveCollection:c('dashboard.save_collection','Save collection point'),
  cancel:c('dashboard.cancel','Cancel'),
  collectionSaving:c('dashboard.collection_saving','Saving…'),
  collectionUpdated:c('dashboard.collection_updated','Collection point updated.'),
  collectionFailed:c('dashboard.collection_failed','The collection point could not be updated.'),
  commitmentEyebrow:c('dashboard.commitment_eyebrow','Your commitment'),
  commitmentBody:c('dashboard.commitment_body','Your regular contribution creates predictable demand that local producers can plan around.'),

  regularPaymentHeading:c('dashboard.regular_payment_heading','Your regular payment'),
  setupRegularPaymentHeading:c('dashboard.setup_regular_payment_heading','Set up your regular payment'),
  regularPaymentBody:c('dashboard.regular_payment_body','Set up a BACS standing order using the details below.'),
  averageOrders:c('dashboard.average_orders','Average weekly orders'),
  recentPayments:c('dashboard.recent_payments','Recent payments'),
  noPayments:c('dashboard.no_payments','No recent payments found.'),
  accountActivity:c('dashboard.account_activity','View full account activity'),
  increasePrompt:c('dashboard.commitment_increase_prompt','Your average weekly orders are {average}, above your {commitment}/week commitment. If that reflects what you expect to spend most weeks, consider increasing your commitment.'),
  changeCommitment:c('dashboard.change_commitment','Change'),
  changeCommitmentPrompt:c('dashboard.change_commitment_prompt','Change commitment'),
  commitmentFrequency:c('dashboard.commitment_frequency','Payment frequency'),
  weeklyFrequency:c('dashboard.commitment_weekly','Weekly'),
  monthlyFrequency:c('dashboard.commitment_monthly','Monthly'),
  commitmentAmount:c('dashboard.commitment_amount','Commitment amount'),
  weeklyMinimum:c('dashboard.commitment_weekly_minimum','Minimum £10.00/week.'),
  monthlyMinimum:c('dashboard.commitment_monthly_minimum','Minimum £43.33/month (equivalent to £10/week).'),
  saveCommitment:c('dashboard.save_commitment','Save commitment'),
  commitmentSaving:c('dashboard.commitment_saving','Saving…'),
  commitmentUpdated:c('dashboard.commitment_updated','Commitment updated. Please update your standing order to match.'),
  commitmentFailed:c('dashboard.commitment_failed','Your commitment could not be updated.'),
  updateRegularPaymentHeading:c('dashboard.update_regular_payment_heading','Please update your standing order'),
  commitmentPaymentReminder:c('dashboard.commitment_payment_reminder','You recently changed your {frequency} commitment to {amount}/{period}. Please remember to change your standing order accordingly. This message will disappear once we receive a payment that matches your new commitment amount.'),
  paymentOverdueHeading:c('dashboard.payment_overdue_heading','Your regular payment hasn’t arrived'),
  paymentOverdueBody:c('dashboard.payment_overdue_body','We haven’t received the regular payment we were expecting. If you’re taking a break, [let us know](/faqs/#pauses) and you can pause your regular commitment for up to **8 weeks in each calendar year** without losing your [consecutive-weeks streak](/faqs/#member-streaks). If this was just a missed or delayed payment, please check your standing order. Your streak is protected for one calendar month from the missed payment date.'),
  inactiveHeading:c('dashboard.membership_inactive_heading','Your membership is inactive'),
  inactiveBody:c('dashboard.membership_inactive_body','We haven’t received your regular commitment for a calendar month and you haven’t arranged a pause, so your consecutive-weeks streak has ended and your progression perks have reset. You can restart your membership at any time by resuming your regular commitment. Any Member Credit already in your account remains available to spend. If we’ve got this wrong, please get in touch.'),
  loading:c('dashboard.loading','Loading your membership…'),
  invalidHeading:c('dashboard.invalid_link_heading','This secure link is no longer valid'),
  invalidBody:c('dashboard.invalid_link_body','Request a new link from checkout or use the latest weekly email.'),
  emailVerified:c('dashboard.email_verified','Email address confirmed.'),
  weekUnit:c('dashboard.week_unit','week'),
  weeksUnit:c('dashboard.weeks_unit','weeks'),
  perWeek:c('dashboard.per_week','per week'),
  perMonth:c('dashboard.per_month','per month'),
  collectionImageAlt:c('dashboard.collection_image_alt','{name} collection point'),
  referenceHelp:c('dashboard.reference_help',"This reference matters — it's how your payment reached your account."),
  involvementEyebrow:c('dashboard.involvement_eyebrow','Your involvement'),
  volunteerDays:c('dashboard.volunteer_days','volunteering in your local food network'),
  workshopsAttended:c('dashboard.workshops_attended','workshops attended'),
  eventsAttended:c('dashboard.events_attended','events attended'),
  dayUnit:c('dashboard.day_unit','day'),
  daysUnit:c('dashboard.days_unit','days'),
  biggerHeading:c('dashboard.bigger_heading',"You’re part of something bigger."),
  biggerLink:c('dashboard.bigger_link','See what our network is growing, sharing and giving back →'),
  biggerUrl:c('dashboard.bigger_url','/our-partners/')
};
const dashboardConfigJson = JSON.stringify({ badgeLogos, memberBadge, membershipPerks, collectionPoints:data.collectionPoints, bankAccountName:s.bankAccountName, bankSortCode:s.bankSortCode, bankAccountNumber:s.bankAccountNumber, copy }).replace(/</g, '\\u003c');
---
<BaseLayout settings={s} pages={data.pages} title={page.seoTitle || page.title} description={page.seoDescription || page.intro}>
  <PageHero page={page} />

  <main class="dashboard-shell">
    <section id="dashboard-loading" class="dashboard-card"><p>{copy.loading}</p></section>
    <p id="dashboard-email-verified" class="dashboard-verified-notice" hidden>{copy.emailVerified}</p>

    <section id="dashboard-content" hidden>
      <div class="dashboard-primary-grid">
      <article class="dashboard-card dashboard-membership-card dashboard-membership-v295">
        <h1 id="dashboard-greeting" class="dashboard-member-greeting">Hi member</h1>
        <p class="eyebrow dashboard-membership-eyebrow">{copy.membershipEyebrow}</p>

        <div class="dashboard-membership-identity">
          <div id="dashboard-badge" class="dashboard-badge"></div>
          <div class="dashboard-membership-actions">
            <p class="dashboard-credit dashboard-membership-credit">
              <span>{copy.creditLabel}</span>
              <strong id="dashboard-credit-value">£0.00</strong>
            </p>
            <a id="dashboard-shop-link" class="button dashboard-market-button" href="/orders/">{copy.browseMarket}</a>
          </div>
        </div>

        <section id="dashboard-payment-prompt" class="dashboard-payment-choice" hidden>
          <div class="dashboard-payment-choice-heading">
            <strong id="dashboard-topup-needed"></strong>
            <span>{copy.topupRequirement}</span>
          </div>

          <fieldset class="dashboard-payment-options">
            <label>
              <input type="radio" name="dashboard-payment-method" value="bank" checked />
              <span>{copy.payBank} <em>({copy.recommended.toLowerCase()})</em></span>
            </label>
            <label>
              <input type="radio" name="dashboard-payment-method" value="card" />
              <span>{copy.payCard}</span>
            </label>
            <label>
              <input type="radio" name="dashboard-payment-method" value="open-banking" />
              <span>{copy.payOpenBanking}</span>
            </label>
          </fieldset>

          <div id="dashboard-payment-bank" class="dashboard-payment-method-detail">
            <dl class="bank-details">
              <div><dt>{copy.bankAccountName}</dt><dd id="dashboard-topup-bank-name"></dd></div>
              <div><dt>{copy.bankSortCode}</dt><dd id="dashboard-topup-sort-code"></dd></div>
              <div><dt>{copy.bankAccountNumber}</dt><dd id="dashboard-topup-account-number"></dd></div>
              <div><dt>{copy.bankReference}</dt><dd id="dashboard-topup-reference"></dd></div>
            </dl>
            <p class="dashboard-reference-help">{copy.referenceHelp}</p>
          </div>

          <div id="dashboard-payment-card" class="dashboard-payment-method-detail" hidden>
            <p class="small-print">{copy.cardComingSoon}</p>
          </div>

          <div id="dashboard-payment-open-banking" class="dashboard-payment-method-detail" hidden>
            <p class="small-print">{copy.openBankingComingSoon}</p>
          </div>
        </section>

        <div class="dashboard-membership-tenure">
          <div class="dashboard-streak-line"><strong id="dashboard-member-weeks">0</strong> <a href="/faqs/#member-streaks">{copy.consecutiveWeeks}</a></div>
          <span>{copy.weeksSupporting}</span>
        </div>

        <section id="dashboard-pause-area" class="dashboard-pause-area">
          <div id="dashboard-pause-intro" class="dashboard-pause-intro">
            <strong>{copy.pauseIntroHeading}</strong>
            <FormattedText text={copy.pauseIntroBody} class="rich-body" />
            <button id="dashboard-pause-open" class="button button-secondary" type="button">{copy.pauseButton}</button>
          </div>
          <div id="dashboard-pause-active" class="dashboard-status-highlight" hidden>
            <h3 id="dashboard-pause-active-heading"></h3>
            <div id="dashboard-pause-active-body" class="rich-body"></div>
            <button id="dashboard-pause-end" class="button button-secondary" type="button">{copy.pauseEndEarly}</button>
          </div>
          <form id="dashboard-pause-form" class="dashboard-pause-form" hidden>
            <label>{copy.pauseFrom}<input id="dashboard-pause-start" type="date" required /></label>
            <label>{copy.pauseUntil}<input id="dashboard-pause-end" type="date" required /></label>
            <p id="dashboard-pause-allowance" class="small-print"></p>
            <div class="dashboard-point-actions">
              <button class="button" type="submit">{copy.pauseConfirm}</button>
              <button id="dashboard-pause-form-cancel" class="button button-secondary" type="button">{copy.pauseCancel}</button>
            </div>
            <p id="dashboard-pause-message" class="small-print" aria-live="polite"></p>
          </form>
        </section>
        <div id="dashboard-perks" class="dashboard-perks"></div>
      </article>


      <article class="dashboard-card dashboard-commitment-card">
          <p class="eyebrow">{copy.commitmentEyebrow}</p>
          <div class="commitment-heading-row">
            <p class="commitment-amount"><strong id="dashboard-commitment">£0</strong><span id="dashboard-commitment-suffix">/week</span></p>
            <button id="dashboard-change-commitment" class="button commitment-change-button" type="button">{copy.changeCommitment}</button>
          </div>
          <FormattedText text={copy.commitmentBody} class="rich-body" />

          <form id="dashboard-commitment-form" class="commitment-editor" hidden>
            <fieldset>
              <legend>{copy.commitmentFrequency}</legend>
              <label><input type="radio" name="commitmentFrequency" value="Weekly" /> <span>{copy.weeklyFrequency}</span></label>
              <label><input type="radio" name="commitmentFrequency" value="Monthly" /> <span>{copy.monthlyFrequency}</span></label>
            </fieldset>
            <label class="commitment-editor-amount">
              <span>{copy.commitmentAmount}</span>
              <span class="commitment-stepper">
                <button type="button" data-commitment-step="-1" aria-label="Reduce commitment">−</button>
                <span class="commitment-input-wrap"><span>£</span><input id="dashboard-commitment-input" name="commitmentAmount" type="number" inputmode="decimal" step="0.01" min="10" required /></span>
                <button type="button" data-commitment-step="1" aria-label="Increase commitment">+</button>
              </span>
              <small id="dashboard-commitment-help">{copy.weeklyMinimum}</small>
            </label>
            <div class="dashboard-point-actions">
              <button class="button" type="submit">{copy.saveCommitment}</button>
              <button id="dashboard-cancel-commitment" class="button button-secondary" type="button">{copy.cancel}</button>
            </div>
            <p id="dashboard-commitment-message" class="small-print" aria-live="polite"></p>
          </form>

          <section id="dashboard-regular-payment-details" class="regular-payment-details" hidden>
            <h3 id="dashboard-regular-payment-heading">{copy.regularPaymentHeading}</h3>
            <div id="dashboard-regular-payment-reminder" class="dashboard-status-highlight" hidden><h4 id="dashboard-regular-payment-reminder-heading"></h4><div id="dashboard-regular-payment-reminder-body" class="rich-body"></div></div>
            <div id="dashboard-regular-payment-body"><FormattedText text={copy.regularPaymentBody} class="rich-body" /></div>
            <dl class="bank-details">
              <div><dt>{copy.bankAccountName}</dt><dd id="dashboard-regular-bank-name"></dd></div>
              <div><dt>{copy.bankSortCode}</dt><dd id="dashboard-regular-sort-code"></dd></div>
              <div><dt>{copy.bankAccountNumber}</dt><dd id="dashboard-regular-account-number"></dd></div>
              <div><dt>{copy.bankReference}</dt><dd id="dashboard-regular-payment-reference"></dd></div>
            </dl>
            <p class="dashboard-reference-help dashboard-regular-reference-help">{copy.referenceHelp}</p>
          </section>

          <div id="dashboard-existing-commitment-detail">
            <div id="dashboard-commitment-metrics" class="commitment-metrics" hidden>
              <div><span>{copy.averageOrders}</span><strong id="dashboard-average-spend">£0.00</strong></div>
            </div>
            <div id="dashboard-increase-prompt" class="commitment-prompt" hidden>
              <p id="dashboard-increase-copy"></p>
              <button id="dashboard-prompt-change-commitment" class="button" type="button">{copy.changeCommitmentPrompt}</button>
            </div>
            <div class="recent-topups">
              <h3>{copy.recentPayments}</h3>
              <div id="dashboard-topups"><p class="small-print">{copy.noPayments}</p></div>
              <details id="dashboard-account-activity" class="account-activity">
                <summary>{copy.accountActivity}</summary>
                <div id="dashboard-activity"></div>
              </details>
            </div>
          </div>
      </article>

      </div>

      <div class="dashboard-secondary-grid">
        <article id="collection-point" class="dashboard-card dashboard-collection">
          <p class="eyebrow">{copy.collectionEyebrow}</p>
          <img id="dashboard-point-image" class="dashboard-point-image" src="" alt="" hidden />
          <h2 id="dashboard-point-name">{copy.collectionNotSelected}</h2>
          <p id="dashboard-point-time"></p>
          <p id="dashboard-point-address"></p>
          <button id="dashboard-change-point" class="button dashboard-change-point" type="button">{copy.changeCollection}</button>

          <form id="dashboard-point-form" class="dashboard-point-form" hidden>
            <div class="dashboard-point-label-row">
              <label for="dashboard-point-select">{copy.chooseCollection}</label>
              <a class="dashboard-map-link" href="/collection-points/?return=/dashboard/&select=1">({copy.collectionMapLink})</a>
            </div>
            <select id="dashboard-point-select" required></select>
            <label for="dashboard-day-select">and collection day</label>
            <select id="dashboard-day-select" required></select>
            <div class="dashboard-point-actions">
              <button class="button" type="submit">{copy.saveCollection}</button>
              <button id="dashboard-cancel-point" class="button button-secondary" type="button">{copy.cancel}</button>
            </div>
            <p id="dashboard-point-message" class="small-print" aria-live="polite"></p>
          </form>
        </article>

        <article class="dashboard-card dashboard-impact-card dashboard-involvement-card">
          <p class="eyebrow">{copy.involvementEyebrow}</p>
          <div class="dashboard-participation-grid">
            <p class="dashboard-participation-stat">
              <strong id="dashboard-impact">£0</strong>
              <span>{copy.localImpact}</span>
            </p>
            <p class="dashboard-participation-stat">
              <strong id="dashboard-volunteer-days">0 {copy.daysUnit}</strong>
              <span>{copy.volunteerDays}</span>
            </p>
            <p class="dashboard-participation-stat">
              <strong id="dashboard-workshops-attended">0</strong>
              <span>{copy.workshopsAttended}</span>
            </p>
            <p class="dashboard-participation-stat">
              <strong id="dashboard-events-attended">0</strong>
              <span>{copy.eventsAttended}</span>
            </p>
          </div>
          <div class="dashboard-bigger-picture">
            <strong>{copy.biggerHeading}</strong>
            <a class="text-link" href={copy.biggerUrl}>{copy.biggerLink}</a>
          </div>
        </article>
      </div>
    </section>
  </main>

  {blocks.map((block)=><SectionRenderer block={block} products={data.products} settings={s} />)}

  <script id="dashboard-config" type="application/json" set:html={dashboardConfigJson}></script>
  <script type="module" src="/scripts/dashboard.js?v=2.9.78"></script>
</BaseLayout>
