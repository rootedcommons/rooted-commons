---
import FormattedText from '../components/FormattedText.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionRenderer from '../components/SectionRenderer.astro';
import { getSiteData } from '../lib/baserow';
import { buildSectionBlocks } from '../lib/sections';

const data=await getSiteData();
const page=data.pages.find((item)=>item.slug==='dashboard') || {title:'Your Rooted Commons',intro:'Your weekly market, membership and local food network in one place.',titleSize:'large',introSize:'medium',heroLayout:'none'};
const blocks=buildSectionBlocks(data.sections.filter((section)=>section.page==='dashboard'));
const s=data.settings;
const c=(key, fallback='')=>data.interfaceContent[key] || fallback;
const badgeLogos={
  'Founder 10':s.founder10Badge,
  'Founder 25':s.founder25Badge,
  'Founder 50':s.founder50Badge
};
const membershipPerks=s.membershipPerks || [];
---
<BaseLayout settings={s} pages={data.pages} title={page.seoTitle || page.title} description={page.seoDescription || page.intro}>
  <PageHero page={page} />

  <main class="dashboard-shell">
    <section id="dashboard-loading" class="dashboard-card"><p>{c('dashboard.loading')}</p></section>
    <section id="dashboard-content" hidden>
      <div class="dashboard-overview">
        <article class="dashboard-card dashboard-welcome">
          <h1 id="dashboard-greeting">Hi member</h1>
          <p class="dashboard-credit"><span>{c('dashboard.credit_label')}</span><strong id="dashboard-credit-value">£0.00</strong></p>
          <div id="dashboard-payment-prompt" class="dashboard-payment-prompt" hidden></div>
          <a id="dashboard-mollie-link" class="button dashboard-topup-link" hidden>{c('dashboard.online_button')}</a>
          <a id="dashboard-shop-link" class="button" href="/orders/">{c('dashboard.shop_button')}</a>
        </article>

        <article class="dashboard-card dashboard-membership-card">
          <div class="dashboard-membership-copy">
            <div id="dashboard-badge" class="dashboard-badge"></div>
            <p class="eyebrow">{c('dashboard.membership_eyebrow')}</p>
            <h2 id="dashboard-founder-level">{c('dashboard.default_member_level')}</h2>
            <div class="dashboard-impact-stats">
              <p class="dashboard-impact-stat"><strong id="dashboard-member-weeks">0 weeks</strong><span>supporting local producers</span></p>
              <p class="dashboard-impact-stat"><strong id="dashboard-impact">£0</strong><span>{c('dashboard.local_impact')}</span></p>
            </div>
            <p id="dashboard-last-order"></p>
            <div id="dashboard-perks" class="dashboard-perks"></div>
          </div>
        </article>
      </div>

      <div class="dashboard-detail-grid">
        <article class="dashboard-card dashboard-collection">
          <p class="eyebrow">{c('dashboard.collection_eyebrow')}</p>
          <img id="dashboard-point-image" class="dashboard-point-image" src="" alt="" hidden />
          <h2 id="dashboard-point-name">Not selected</h2>
          <p id="dashboard-point-time"></p>
          <p id="dashboard-point-preference" class="small-print"></p>
          <p id="dashboard-point-address"></p>
          <p id="dashboard-point-deadline" class="collection-deadline-readable"></p>
          <a id="dashboard-point-link" class="text-link" hidden>View collection point →</a>
          <button id="dashboard-change-point" class="button dashboard-change-point" type="button">{c('dashboard.change_collection')}</button>
          <form id="dashboard-point-form" class="dashboard-point-form" hidden>
            <label for="dashboard-point-select">{c('dashboard.choose_collection')}</label>
            <select id="dashboard-point-select" required></select>
            <label for="dashboard-day-select">Preferred collection day</label>
            <select id="dashboard-day-select" required></select>
            <div class="dashboard-point-actions">
              <button class="button" type="submit">{c('dashboard.save_collection')}</button>
              <button id="dashboard-cancel-point" class="button button-secondary" type="button">{c('dashboard.cancel')}</button>
            </div>
            <p id="dashboard-point-message" class="small-print" aria-live="polite"></p>
          </form>
        </article>

        <article class="dashboard-card dashboard-commitment-card">
          <p class="eyebrow">{c('dashboard.commitment_eyebrow')}</p>
          <p class="commitment-amount"><strong id="dashboard-commitment">£0</strong><span>/week</span></p>
          <FormattedText text={c('dashboard.commitment_body')} class="rich-body" />
          <p id="dashboard-monthly-equivalent" class="small-print"></p>
          <section class="regular-payment-details">
            <h3>{c('dashboard.regular_payment_heading')}</h3>
            <FormattedText text={c('dashboard.regular_payment_body')} class="rich-body" />
            <dl class="bank-details">
              <div><dt>Account name</dt><dd id="dashboard-regular-bank-name"></dd></div>
              <div><dt>Sort code</dt><dd id="dashboard-regular-sort-code"></dd></div>
              <div><dt>Account number</dt><dd id="dashboard-regular-account-number"></dd></div>
              <div><dt>Reference</dt><dd id="dashboard-regular-payment-reference"></dd></div>
            </dl>
            <FormattedText text={c('dashboard.regular_payment_note')} class="small-print rich-body" />
          </section>
          <div class="commitment-metrics">
            <div><span>{c('dashboard.average_orders')}</span><strong id="dashboard-average-spend">£0.00</strong></div>
          </div>
          <div class="recent-topups">
            <h3>{c('dashboard.recent_payments')}</h3>
            <div id="dashboard-topups"><p class="small-print">{c('dashboard.no_payments')}</p></div>
            <details id="dashboard-account-activity" class="account-activity">
              <summary>{c('dashboard.account_activity')}</summary>
              <div id="dashboard-activity"></div>
            </details>
          </div>
          <div id="dashboard-increase-prompt" class="commitment-prompt" hidden>
            <p id="dashboard-increase-copy"></p>
            {s.increaseCommitmentButtonUrl && <a class="button" href={s.increaseCommitmentButtonUrl}>{s.increaseCommitmentButtonText}</a>}
          </div>
        </article>
      </div>
    </section>
  </main>

  {blocks.map((block)=><SectionRenderer block={block} products={data.products} settings={s} />)}

  <script is:inline define:vars={{ badgeLogos, membershipPerks, collectionPoints:data.collectionPoints, bankAccountName:s.bankAccountName, bankSortCode:s.bankSortCode, bankAccountNumber:s.bankAccountNumber }}>
    const TOKEN_KEY='rooted-commons-order-token-v1';
    const params=new URLSearchParams(location.search);
    const urlToken=params.get('token');
    if(urlToken)localStorage.setItem(TOKEN_KEY,urlToken);
    const token=urlToken||localStorage.getItem(TOKEN_KEY)||'';
    const money=new Intl.NumberFormat('en-GB',{style:'currency',currency:'GBP'});
    const formatDate=value=>value?new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'short',year:'numeric'}).format(new Date(value)):'';
    const pointSelect=document.querySelector('#dashboard-point-select');
    const pointForm=document.querySelector('#dashboard-point-form');
    const daySelect=document.querySelector('#dashboard-day-select');
    const pointMessage=document.querySelector('#dashboard-point-message');
    const populatePointSelect=(selectedId)=>{
      pointSelect.innerHTML=(collectionPoints||[]).map(point=>`<option value="${point.id}" ${Number(point.id)===Number(selectedId)?'selected':''}>${point.name}</option>`).join('');
    };
    const populateDaySelect=(selectedDay='')=>{
      const point=(collectionPoints||[]).find(item=>Number(item.id)===Number(pointSelect.value));
      const slots=point?.collectionSlots||[];
      daySelect.innerHTML=slots.map(slot=>`<option value="${slot.day}">${slot.day} — ${slot.time}</option>`).join('');
      if(slots.some(slot=>slot.day===selectedDay))daySelect.value=selectedDay;
    };
    pointSelect.addEventListener('change',()=>populateDaySelect(''));
    document.querySelector('#dashboard-change-point').addEventListener('click',()=>{pointForm.hidden=false;pointMessage.textContent='';pointSelect.focus();});
    document.querySelector('#dashboard-cancel-point').addEventListener('click',()=>{pointForm.hidden=true;pointMessage.textContent='';});
    pointForm.addEventListener('submit',async event=>{
      event.preventDefault();
      const button=pointForm.querySelector('button[type="submit"]');
      button.disabled=true;
      pointMessage.textContent='Saving…';
      const response=await fetch('/api/member',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({token,collectionPointId:Number(pointSelect.value),preferredCollectionDay:daySelect.value})});
      const payload=await response.json();
      if(response.ok&&payload.ok){
        const point=payload.collectionPoint||{};
        document.querySelector('#dashboard-point-name').textContent=point.name||'Not selected';
        const slot=(point.collectionSlots||[]).find(item=>item.day===payload.preferredCollectionDay)||(point.collectionSlots||[])[0];
        document.querySelector('#dashboard-point-time').textContent=slot?`${slot.day} · ${slot.time}`:(point.collectionTime||'');
        document.querySelector('#dashboard-point-preference').textContent=slot?'Your preferred collection slot. Checkout will offer earlier options if your basket contains fresher items.':'';
        document.querySelector('#dashboard-point-address').textContent=point.address||'';
        const pointImage=document.querySelector('#dashboard-point-image');
        if(point.image){pointImage.src=point.image;pointImage.alt=point.name?`${point.name} collection point`:'';pointImage.hidden=false;}else{pointImage.hidden=true;pointImage.removeAttribute('src');}
        document.querySelector('#dashboard-point-deadline').textContent='Orders close Wednesday 18.00.';
        const pointLink=document.querySelector('#dashboard-point-link');
        pointLink.hidden=!point.link;
        if(point.link)pointLink.href=point.link;
        pointMessage.textContent='Collection point updated.';
        setTimeout(()=>{pointForm.hidden=true;pointMessage.textContent='';},900);
      }else pointMessage.textContent=payload.message||'The collection point could not be updated.';
      button.disabled=false;
    });
    const formatLocalDeadline=value=>{
      if(!value)return '';
      const raw=String(value).trim();
      const match=raw.match(/^(?:\d{4}-\d{2}-\d{2}[T\s])?(\d{1,2})[:.](\d{2})/);
      if(!match)return raw;
      const hour=Number(match[1]);
      const minute=match[2];
      const suffix=hour>=12?'pm':'am';
      const displayHour=hour%12||12;
      return `${displayHour}:${minute}${suffix}`;
    };
    const relativeDate=value=>{
      if(!value)return 'No previous website order';
      const days=Math.max(0,Math.floor((Date.now()-new Date(value).getTime())/86400000));
      if(days===0)return 'You last ordered today';
      if(days===1)return 'You last ordered yesterday';
      if(days<14)return `You last ordered ${days} days ago`;
      const weeks=Math.floor(days/7);
      return `You last ordered ${weeks} week${weeks===1?'':'s'} ago`;
    };
    const renderPerks=(weeks)=>{
      const perks=(membershipPerks||[]).map(item=>({label:item.label,unlockWeeks:Number(item.unlockWeeks)||0})).filter(item=>item.label);
      const unlocked=perks.filter(item=>weeks>=item.unlockWeeks);
      const next=perks.find(item=>weeks<item.unlockWeeks);
      const container=document.querySelector('#dashboard-perks');
      if(!perks.length){container.hidden=true;return;}
      container.innerHTML=`<h3>You’ve unlocked…</h3>${unlocked.length?`<ul>${unlocked.map(item=>`<li>${item.label}</li>`).join('')}</ul>`:'<p>Your first member perk is on its way.</p>'}${next?`<p class="next-perk"><strong>Next:</strong> ${next.label} — unlocks in ${next.unlockWeeks-weeks} week${next.unlockWeeks-weeks===1?'':'s'}.</p>`:''}`;
    };
    const renderTopups=payments=>{
      const container=document.querySelector('#dashboard-topups');
      if(!payments?.length)return;
      container.innerHTML=payments.map(item=>`<div class="topup-line"><span>${formatDate(item.date)}${item.type?` · ${item.type}`:''}</span><strong>+${money.format(Math.abs(item.amount||0))}</strong></div>`).join('');
    };

    const renderActivity=activity=>{
      const container=document.querySelector('#dashboard-activity');
      if(!activity?.length){document.querySelector('#dashboard-account-activity').hidden=true;return;}
      container.innerHTML=activity.map(item=>{
        const amount=Number(item.amount)||0;
        const sign=amount>0?'+':'';
        return `<div class="activity-line"><span>${formatDate(item.date)}<small>${item.type||item.notes||'Account activity'}</small></span><strong class="${amount<0?'amount-negative':'amount-positive'}">${sign}${money.format(amount)}</strong></div>`;
      }).join('');
    };
    async function load(){
      if(!token){location.href='/orders/';return;}
      const response=await fetch(`/api/member?token=${encodeURIComponent(token)}`);
      if(!response.ok){document.querySelector('#dashboard-loading').innerHTML='<h2>This secure link is no longer valid</h2><p>Request a new link from checkout or use the latest weekly email.</p>';return;}
      const {member}=await response.json();
      document.querySelector('#dashboard-loading').hidden=true;
      document.querySelector('#dashboard-content').hidden=false;
      document.querySelector('#dashboard-greeting').textContent=`Hi ${member.firstName||'there'}`;
      document.querySelector('#dashboard-credit-value').textContent=money.format(member.credit||0);
      document.querySelector('#dashboard-shop-link').href=`/orders/?token=${encodeURIComponent(token)}`;
      const point=member.collectionPoint||{};
      populatePointSelect(point.id);
      populateDaySelect(member.preferredCollectionDay||'Thursday');
      document.querySelector('#dashboard-point-name').textContent=point.name||'Choose at checkout';
      const preferredSlot=(point.collectionSlots||[]).find(item=>item.day===member.preferredCollectionDay)||(point.collectionSlots||[])[0];
      document.querySelector('#dashboard-point-time').textContent=preferredSlot?`${preferredSlot.day} · ${preferredSlot.time}`:(point.collectionTime||'');
      document.querySelector('#dashboard-point-preference').textContent=preferredSlot?'Your preferred collection slot. Checkout confirms what is available for each basket.':'';
      document.querySelector('#dashboard-point-address').textContent=point.address||'';
      const pointImage=document.querySelector('#dashboard-point-image');
      if(point.image){pointImage.src=point.image;pointImage.alt=point.name?`${point.name} collection point`:'';pointImage.hidden=false;}else{pointImage.hidden=true;pointImage.removeAttribute('src');}
      document.querySelector('#dashboard-point-deadline').textContent='Orders close Wednesday 18.00.';
      const pointLink=document.querySelector('#dashboard-point-link');
      if(point.link){pointLink.href=point.link;pointLink.hidden=false;}
      document.querySelector('#dashboard-founder-level').textContent=member.founderBadge||'Rooted Commons member';
      const weeks=Number(member.membershipWeeks)||0;
      document.querySelector('#dashboard-member-weeks').textContent=member.membershipWeeks!=null?`${weeks} week${weeks===1?'':'s'}`:(member.memberSince?'Member':'New member');
      document.querySelector('#dashboard-last-order').textContent=member.lastOrder?`${relativeDate(member.lastOrder.submittedAt)} (${money.format(member.lastOrder.total||0)}).`:relativeDate('');
      renderPerks(weeks);
      const logo=badgeLogos[member.founderBadge];
      if(logo)document.querySelector('#dashboard-badge').innerHTML=`<img src="${logo}" alt="${member.founderBadge}">`;

      const commitment=Number(member.weeklyCommitment)||0;
      const average=Number(member.account?.averageWeeklySpend)||0;
      const totalImpact=Number(member.account?.totalOrderSpend)||0;
      document.querySelector('#dashboard-commitment').textContent=money.format(commitment).replace('.00','');
      document.querySelector('#dashboard-monthly-equivalent').textContent=commitment>0?`Equivalent to ${money.format(commitment*52/12)} per month, paid by regular BACS standing order.`:'';
      document.querySelector('#dashboard-regular-bank-name').textContent=bankAccountName||'Roots to Fruits CIC';
      document.querySelector('#dashboard-regular-sort-code').textContent=bankSortCode||'Contact us for bank details';
      document.querySelector('#dashboard-regular-account-number').textContent=bankAccountNumber||'—';
      document.querySelector('#dashboard-regular-payment-reference').textContent=member.paymentReference||`RC-${member.id}`;
      document.querySelector('#dashboard-average-spend').textContent=money.format(average);
      document.querySelector('#dashboard-impact').textContent=money.format(totalImpact).replace('.00','');
      renderTopups(member.account?.payments||[]);
      renderActivity(member.account?.activity||[]);
      const credit=Number(member.credit)||0;
      const paymentPrompt=document.querySelector('#dashboard-payment-prompt');
      const mollie=document.querySelector('#dashboard-mollie-link');
      if(credit<0){
        paymentPrompt.innerHTML=`<strong>${money.format(Math.abs(credit))} top-up needed</strong><span>Your balance must be back to £0.00 or above before collection.</span>`;
        paymentPrompt.hidden=false;
      }
      if(member.molliePaymentUrl && credit<=0){
        mollie.href=member.molliePaymentUrl;
        mollie.textContent=credit<0?`Pay ${money.format(Math.abs(credit))} securely`:'Top up member credit';
        mollie.hidden=false;
      } else { mollie.hidden=true; }
      const threshold=Math.max(2,commitment*.15);
      if(commitment>0&&average>=commitment+threshold){
        document.querySelector('#dashboard-increase-prompt').hidden=false;
        document.querySelector('#dashboard-increase-copy').textContent=`Your recent orders average ${money.format(average)} a week, around ${money.format(average-commitment)} more than your current commitment.`;
      }
    }
    load();
  </script>
</BaseLayout>
