---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedText from '../components/FormattedText.astro';
import { getSiteData } from '../lib/baserow';
const data=await getSiteData();
const s=data.settings;
const c=(key,fallback='')=>data.interfaceContent[key]||fallback;
const page=data.pages.find((item)=>item.slug==='signup')||{title:c('signup.heading','Join Rooted Commons'),intro:c('signup.intro','Become a member and support a stronger local food network.')};
const turnstileSiteKey=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const collectionPoints=data.collectionPoints.map(point=>({id:point.id,name:point.name,collectionSlots:point.collectionSlots||[]}));
---
<BaseLayout settings={s} pages={data.pages} title={page.seoTitle||page.title} description={page.seoDescription||page.intro}>
  <Fragment slot="head">
    {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  </Fragment>
  <main class="signup-shell">
    <section class="signup-card">
      <div id="signup-copy">
        <h1>{c('signup.heading',page.title)}</h1>
        <FormattedText text={c('signup.intro',page.intro)} class="rich-body" />
      </div>
      <form id="signup-form" class="signup-form">
        <label>{c('signup.first_name_label','First name')}<input name="firstName" autocomplete="given-name" required /></label>
        <label>{c('signup.last_name_label','Last name')}<input name="lastName" autocomplete="family-name" required /></label>
        <label class="full">{c('signup.email_label','Email address')}<input name="email" type="email" autocomplete="email" required /></label>
        <label class="full">{c('signup.phone_label','Phone number')}<input name="phone" type="tel" autocomplete="tel" required /><small>{c('signup.phone_help',"We'll only use this if we need to contact you about your membership or an order.")}</small></label>

        <label class="full">{c('signup.collection_day_label','Preferred collection day')}
          <select name="preferredCollectionDay" id="signup-collection-day" required>
            <option value="Thursday">Thursday</option>
            <option value="Friday">Friday</option>
            <option value="Saturday">Saturday</option>
            <option value="Sunday">Sunday</option>
          </select>
        </label>
        <p id="signup-late-collection-note" class="signup-info full" hidden>{c('signup.late_collection_note','All orders are delivered on Thursday. Some locations support late collection of fresh produce on Friday, but only suitable items, such as cupboard staples and refills, can be held for collection over the weekend.')}</p>

        <label class="full">{c('signup.collection_point_label','Collection point')}
          <select name="collectionPointId" id="signup-collection-point" required><option value="">Choose a collection point</option></select>
          <small>{c('signup.collection_point_help','This can be changed at checkout or from your membership dashboard.')}</small>
          <a class="signup-map-link" href="/collection-points/">{c('signup.collection_points_map_link','View collection points on a map →')}</a>
        </label>

        <label class="full">{c('signup.weekly_commitment_label','Weekly commitment')}
          <span class="signup-money-input"><span aria-hidden="true">£</span><input name="weeklyCommitment" type="number" min="10" step="1" value="10" inputmode="numeric" required /><span aria-hidden="true">/ week</span></span>
          <small>{c('signup.weekly_commitment_help','Minimum £10/week. Your regular contribution becomes member credit to spend through the weekly market.')}</small>
        </label>

        <div class="signup-section full">
          <h2>{c('signup.keeping_in_touch_heading','Keeping in touch')}</h2>
          <p>{c('signup.keeping_in_touch_body',"Each Friday, we'll email you a unique link to the following week's market. This gives you secure access to your account and member credit without needing a password.")}</p>
          <label class="signup-check"><input name="weeklyNewsletter" type="checkbox" /><span>{c('signup.weekly_newsletter_text',"I'm happy for occasional Rooted Commons news and updates to be included in this weekly email.")}</span></label>
        </div>

        <label class="signup-check full"><input name="membershipConsent" type="checkbox" required /><span>{c('signup.membership_consent_prefix','I agree to the')} <a href="/membership-terms/">{c('signup.membership_terms_link','Rooted Commons Membership Terms')}</a> {c('signup.privacy_prefix','and have read the')} <a href="/privacy/">{c('signup.privacy_link','Privacy Policy')}</a>.</span></label>

        <div class="full signup-turnstile-wrap">
          {turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-appearance="interaction-only" data-response-field="true"></div> : <p class="signup-config-warning">Signup protection is not configured yet. Add the Turnstile site key before publishing this form.</p>}
        </div>
        <button class="button full" type="submit" disabled={!turnstileSiteKey}>{c('signup.submit_button','Join Rooted Commons')}</button>
        <p id="signup-message" class="signup-message" aria-live="polite"></p>
      </form>
      <div id="signup-success" class="signup-success" hidden><h2>{c('signup.success_heading','Welcome to Rooted Commons')}</h2><FormattedText text={c('signup.success_message','Your membership has been created. We’ll send you the information you need to get started.')} class="rich-body" /></div>
    </section>
  </main>
  <script is:inline define:vars={{ collectionPoints }}>
    const form=document.querySelector('#signup-form');
    const message=document.querySelector('#signup-message');
    const success=document.querySelector('#signup-success');
    const daySelect=document.querySelector('#signup-collection-day');
    const pointSelect=document.querySelector('#signup-collection-point');
    const lateNote=document.querySelector('#signup-late-collection-note');
    const escapeHtml=(value)=>String(value??'').replace(/[&<>'\"]/g,(char)=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','\"':'&quot;'}[char]));
    function refreshCollectionPoints(){
      const day=daySelect?.value||'Thursday';
      if(lateNote)lateNote.hidden=day==='Thursday';
      const available=(collectionPoints||[]).map(point=>{
        const slot=(point.collectionSlots||[]).find(item=>item.day===day);
        return slot?{...point,time:slot.time}:null;
      }).filter(Boolean);
      if(pointSelect){
        const existing=pointSelect.value;
        pointSelect.innerHTML='<option value="">Choose a collection point</option>'+available.map(point=>`<option value="${point.id}">${escapeHtml(point.name)} — ${escapeHtml(point.time)}</option>`).join('');
        if(available.some(point=>String(point.id)===String(existing)))pointSelect.value=existing;
      }
    }
    daySelect?.addEventListener('change',refreshCollectionPoints);
    refreshCollectionPoints();
    form?.addEventListener('submit',async(event)=>{
      event.preventDefault();message.textContent='';const button=form.querySelector('button[type="submit"]');button.disabled=true;
      try{
        const fd=new FormData(form);
        const turnstileToken=fd.get('cf-turnstile-response')||document.querySelector('input[name="cf-turnstile-response"]')?.value||'';
        if(!turnstileToken)throw new Error('Please complete the security check and try again.');
        const response=await fetch('/api/signup',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({firstName:fd.get('firstName'),lastName:fd.get('lastName'),email:fd.get('email'),phone:fd.get('phone'),preferredCollectionDay:fd.get('preferredCollectionDay'),collectionPointId:Number(fd.get('collectionPointId')),weeklyCommitment:Number(fd.get('weeklyCommitment')),membershipConsent:fd.get('membershipConsent')==='on',weeklyNewsletter:fd.get('weeklyNewsletter')==='on',turnstileToken})});
        const payload=await response.json();if(!response.ok)throw new Error(payload.message||'Signup failed.');form.hidden=true;document.querySelector('#signup-copy').hidden=true;success.hidden=false;
      }catch(error){message.textContent=error.message||'We could not create your membership. Please try again.';button.disabled=false;if(window.turnstile)window.turnstile.reset();}
    });
  </script>
</BaseLayout>
