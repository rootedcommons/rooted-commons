---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedText from '../components/FormattedText.astro';
import { getSiteData } from '../lib/baserow';
const data=await getSiteData();
const s=data.settings;
const c=(key,fallback='')=>data.interfaceContent[key]||fallback;
const page=data.pages.find((item)=>item.slug==='signup')||{title:c('signup.heading','Join Rooted Commons'),intro:c('signup.intro','Become a member and support a stronger local food network.')};
const turnstileSiteKey=import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
const collectionPoints=data.collectionPoints.map(point=>({id:point.id,name:point.name,collectionSlots:point.collectionSlots||[]}));
const signupConfigJson=JSON.stringify({collectionPoints}).replace(/</g,'\\u003c');
---
<BaseLayout settings={s} pages={data.pages} title={page.seoTitle||page.title} description={page.seoDescription||page.intro}>
  <Fragment slot="head">
    {turnstileSiteKey && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  </Fragment>
  <main class="signup-shell">
    <section class="signup-card">
      <div id="signup-copy">
        <h1>{c('signup.heading',page.title)}</h1>
        <FormattedText text={c('signup.intro',page.intro)} class="rich-body" />
      </div>
      <form id="signup-form" class="signup-form">
        <label>{c('signup.first_name_label','First name')}<input name="firstName" autocomplete="given-name" required /></label>
        <label>{c('signup.last_name_label','Last name')}<input name="lastName" autocomplete="family-name" required /></label>
        <label class="full">{c('signup.email_label','Email address')}<input name="email" type="email" autocomplete="email" required /></label>
        <label class="full">{c('signup.confirm_email_label','Confirm email address')}<input name="confirmEmail" type="email" autocomplete="email" required /></label>
        <label class="full"><span class="signup-label-line"><span>{c('signup.phone_label','Phone number')}</span><small class="signup-inline-help">{c('signup.phone_help',"We'll only need this if there's an issue with your membership or an order.")}</small></span><input name="phone" type="tel" autocomplete="tel" required /></label>

        <div class="signup-section-heading full">
          <h2>{c('signup.collection_details_heading','Collection details')}</h2>
          <p class="signup-inline-help">{c('signup.collection_point_help','This can be changed at checkout or from your membership dashboard.')}</p>
        </div>

        <label class="full"><span class="signup-label-line"><span>{c('signup.collection_point_label','Collection point')} <a class="signup-map-link" href="/collection-points/?return=/signup/&select=1">({c('signup.collection_points_map_link','see our map')})</a></span><small class="signup-inline-help">{c('signup.collection_point_late_help','Only some locations support late collection.')}</small></span>
          <select name="collectionPointId" id="signup-collection-point" required><option value="">Choose a collection point</option></select>
        </label>

        <label class="full">{c('signup.collection_day_label','Preferred collection day')}
          <select name="preferredCollectionDay" id="signup-collection-day" required><option value="">Choose a collection point first</option></select>
        </label>
        <p id="signup-late-collection-note" class="signup-info full" hidden>{c('signup.late_collection_note','All orders are delivered on Thursday. Some locations support late collection of fresh produce on Friday, but only suitable items, such as cupboard staples and refills, can be held for collection over the weekend.')}</p>

        <div class="signup-section-heading full">
          <h2>{c('signup.weekly_commitment_label','Weekly commitment')}</h2>
        </div>

        <fieldset class="signup-frequency full">
          <legend>{c('signup.contribution_frequency_label','How often would you like to add to your member credit?')}</legend>
          <div class="signup-frequency-options">
            <label><input type="radio" name="contributionFrequency" value="Weekly" checked /><span>{c('signup.frequency_weekly_label','Weekly')}</span></label>
            <label><input type="radio" name="contributionFrequency" value="Monthly" /><span>{c('signup.frequency_monthly_label','Monthly')}</span></label>
          </div>
        </fieldset>

        <label class="full"><span id="signup-contribution-label" data-weekly={c('signup.weekly_amount_label','Weekly commitment')} data-monthly={c('signup.monthly_amount_label','Monthly commitment')}>{c('signup.weekly_amount_label','Weekly commitment')}</span>
          <span class="signup-money-input">
            <button class="signup-pound-step" type="button" data-contribution-step="-1" aria-label="Reduce commitment">−</button>
            <span aria-hidden="true">£</span><input name="contributionAmount" id="signup-contribution-amount" type="number" min="10" step="0.01" value="10.00" inputmode="decimal" required /><span id="signup-contribution-suffix" aria-hidden="true">/ week</span>
            <button class="signup-pound-step" type="button" data-contribution-step="1" aria-label="Increase commitment">+</button>
          </span>
          <small id="signup-contribution-help" data-weekly={c('signup.weekly_commitment_help','Minimum £10.00/week. Your regular contribution becomes member credit to spend through the weekly market.')} data-monthly={c('signup.monthly_commitment_help','Minimum £43.33/month (equivalent to £10/week). Your regular contribution becomes member credit to spend through the weekly market.')}>{c('signup.weekly_commitment_help','Minimum £10.00/week. Your regular contribution becomes member credit to spend through the weekly market.')}</small>
        </label>

        <div class="signup-section-heading full">
          <h2>{c('signup.requests_heading','Requests')}</h2>
        </div>
        <label class="full signup-request-field"><span class="signup-request-prompt">{c('signup.requests_prompt',"Are there any cupboard staples that you regularly purchase that you'd like us to stock, if we don't already?")}</span>
          <textarea name="productRequests" rows="4" placeholder={c('signup.requests_placeholder','Optional')}></textarea>
        </label>

        <div class="signup-section-heading full">
          <h2>{c('signup.keeping_in_touch_heading','Keeping in touch')}</h2>
        </div>
        <p class="full signup-keeping-copy">{c('signup.keeping_in_touch_body',"Each Wednesday after orders close, we'll email you a new secure access link for the following week's market. When you use it, we'll keep you signed in on that device so you can return without using the link again.")}</p>
        <label class="signup-check full"><input name="weeklyNewsletter" type="checkbox" /><span>{c('signup.weekly_newsletter_text',"I'm happy for occasional Rooted Commons news and updates to be included in this weekly email.")}</span></label>
        <label class="signup-check full"><input name="membershipConsent" type="checkbox" required /><span>{c('signup.membership_consent_prefix','I agree to the')} <a href="/membership-terms/">{c('signup.membership_terms_link','Rooted Commons Membership Terms')}</a> {c('signup.privacy_prefix','and have read the')} <a href="/privacy/">{c('signup.privacy_link','Privacy Policy')}</a>.</span></label>

        <div class="full signup-turnstile-wrap">
          {turnstileSiteKey ? <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-appearance="interaction-only" data-response-field="true"></div> : <p class="signup-config-warning">Signup protection is not configured yet. Add the Turnstile site key before publishing this form.</p>}
        </div>
        <button class="button full" type="submit" disabled={!turnstileSiteKey}>{c('signup.submit_button','Join Rooted Commons')}</button>
        <p id="signup-message" class="signup-message" aria-live="polite"></p>
        <div id="signup-existing-member" class="signup-existing-member full" hidden>
          <strong>{c('signup.existing_member_heading',"It looks like you're already a Rooted Commons member.")}</strong>
          <p>{c('signup.existing_member_body','We can resend your access link to the email address above.')}</p>
          <button id="signup-send-login" class="button" type="button">{c('signup.existing_member_button','Send me my access link')}</button>
          <p id="signup-existing-member-status" class="small-print" aria-live="polite"></p>
        </div>
      </form>
      <div id="signup-success" class="signup-success" hidden>
        <h2>{c('signup.success_heading','Welcome to Rooted Commons')}</h2>
        <FormattedText text={c('signup.success_message','Your membership has been created successfully.')} class="rich-body" />
        <p><a id="signup-dashboard-link" class="button" href="/dashboard/">{c('signup.dashboard_button','Your new member dashboard')}</a></p>
        <FormattedText text={c('signup.dashboard_security',"**Keep your access link private.** It can be used to sign in to your membership on a new device. Once signed in, you'll normally stay signed in on that device for up to 90 days.\n\nWe'll send you a new weekly access link each Wednesday after orders close. Each new weekly link replaces the previous link for new sign-ins, but devices that are already signed in remain signed in.")} class="rich-body" />
      </div>
    </section>
  </main>
  <script id="signup-config" type="application/json" set:html={signupConfigJson}></script>
  <script type="module" src="/scripts/signup.js?v=2.9.71"></script>
</BaseLayout>
