---
import FormattedText from '../components/FormattedText.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionRenderer from '../components/SectionRenderer.astro';
import CollectionPointCard from '../components/CollectionPointCard.astro';
import { getSiteData } from '../lib/baserow';
import { buildSectionBlocks } from '../lib/sections';

const data = await getSiteData();
const page = data.pages.find((item) => item.slug === 'checkout') || {
  title:'Checkout', intro:'Review your order, choose a collection point and continue as a member.', titleSize:'large', introSize:'medium', heroLayout:'text-only'
};
const ordinaryBlocks = buildSectionBlocks(data.sections.filter((section) => section.page === 'checkout'));
const s = data.settings;
const c = (key, fallback = '') => data.interfaceContent[key] || fallback;
const checkoutProducts = data.products.map((product) => ({
  id: product.id,
  name: product.name,
  size: product.size,
  price: product.priceNumber,
  categories: product.categories || [product.category],
  collectionPointIds: product.collectionPointIds || [],
  lateCollection: product.lateCollection || 'thursday-only'
}));
const checkoutPoints = data.collectionPoints;
const checkoutConfigJson = JSON.stringify({ products: checkoutProducts, points: checkoutPoints, checkoutEmptyHeading: c('checkout.empty_heading'), checkoutEmptyText: c('checkout.empty_text'), checkoutConfirmButton: c('checkout.confirm_button'), checkoutSuccessHeading: c('checkout.success_heading'), checkoutFreshnessWarning: c('checkout.freshness_warning', 'Fresh produce is packed on Thursday and may not be at its best by Friday.'), collectionEyebrow:c('dashboard.collection_eyebrow','Your collection point'), collectionNotSelected:c('dashboard.collection_not_selected','Not selected'), chooseCollection:c('dashboard.choose_collection','Choose your collection point'), collectionMapLink:c('dashboard.collection_map_link','see our map'), preferredCollectionDay:c('dashboard.preferred_collection_day','and collection day') }).replace(/</g, '\\u003c');

---
<BaseLayout settings={s} pages={data.pages} title={page.seoTitle || page.title} description={page.seoDescription || page.intro}>
  <PageHero page={page} />

  <main class="checkout-shell checkout-shell-wide">
    <div class="checkout-top-grid">
      <CollectionPointCard
        idPrefix="checkout"
        className="checkout-collection-summary"
        headingId="collection-heading"
        detailsId="checkout-point-details"
        changeButtonId="checkout-change-collection"
        collectionEyebrow={c('dashboard.collection_eyebrow','Your collection point')}
        collectionNotSelected={c('dashboard.collection_not_selected','Not selected')}
        changeCollection="Change collection options"
        chooseCollection={c('dashboard.choose_collection','Choose your collection point')}
        collectionMapLink={c('dashboard.collection_map_link','see our map')}
        preferredCollectionDay={c('dashboard.preferred_collection_day','and collection day')}
        cancel={c('dashboard.cancel','Cancel')}
        mapHref="/collection-points/?return=/checkout/&select=1"
      >
        <div slot="warning" id="checkout-collection-warning" class="checkout-collection-warning" hidden aria-live="polite"></div>

        <div slot="expanded" id="checkout-collection-picker" class="dashboard-point-form" aria-label="Change collection options" hidden>
          <div class="dashboard-point-label-row">
            <label for="checkout-point-select">{c('dashboard.choose_collection','Choose your collection point')}</label>
            <a class="dashboard-map-link" href="/collection-points/?return=/checkout/&select=1">({c('dashboard.collection_map_link','see our map')})</a>
          </div>
          <select id="checkout-point-select"></select>
          <div id="collection-slot-panel" class="checkout-slot-fields" hidden>
            <label for="checkout-day-select">{c('dashboard.preferred_collection_day','and collection day')}</label>
            <select id="checkout-day-select"></select>
            <p id="collection-freshness-warning" class="collection-freshness-warning" hidden></p>
          </div>
          <div class="dashboard-point-actions">
            <button id="checkout-use-collection" class="button" type="button">Use this collection option</button>
            <button id="checkout-cancel-collection" class="button button-secondary" type="button">{c('dashboard.cancel','Cancel')}</button>
          </div>
          <p id="collection-message" class="small-print" aria-live="polite"></p>
        </div>
      </CollectionPointCard>

      <section class="checkout-card checkout-review" aria-labelledby="checkout-order-heading">
        <h2 id="checkout-order-heading">{c('checkout.basket_heading')}</h2>
        <div id="checkout-basket-lines"></div>
        <div class="checkout-total-row"><span>{c('basket.total_label')}</span><strong id="checkout-total">£0.00</strong></div>
      </section>
    </div>

    <div class="checkout-paths">
      <section id="member-path" class="checkout-card checkout-path-card">
        <div id="unverified-member-panel">
          <h2>{c('checkout.member_heading')}</h2>
          <FormattedText text={c('checkout.member_body')} class="rich-body" />
          <form id="email-form">
            <label>{c('checkout.email_label')}<input name="email" type="email" required autocomplete="email" /></label>
            <button class="button" type="submit">{c('checkout.email_button')}</button>
          </form>
          <p id="email-message" class="small-print" aria-live="polite"></p>
        </div>

        <div id="verified-member-panel" hidden>
          <h2>{c('checkout.member_order_heading')}</h2>
          <div id="verified-member"></div>
          <FormattedText text={c('checkout.terms_confirmation','By confirming your order, you agree to our [Terms of Sale](/terms-of-sale/).')} class="checkout-terms-confirmation" />
          <button id="submit-order" class="button" type="button" disabled>{c('checkout.confirm_button')}</button>
          <p id="submit-message" class="small-print" aria-live="polite"></p>
        </div>
      </section>

      <section id="checkout-join-card" class="checkout-card checkout-path-card checkout-join-card">
        <h2>{c('checkout.join_heading')}</h2>
        <FormattedText text={c('checkout.join_body')} class="rich-body" />
        <a class="button" href="/signup/">{c('checkout.join_button')}</a>
      </section>
    </div>

    <p class="checkout-return"><a href="/orders/">← {c('checkout.return_text')}</a></p>
  </main>

  {ordinaryBlocks.map((block) => <SectionRenderer block={block} products={data.products} settings={data.settings} />)}

  <script id="checkout-config" type="application/json" set:html={checkoutConfigJson}></script>
  <script type="module" src="/scripts/checkout.js?v=2.9.92"></script>
</BaseLayout>
